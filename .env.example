# Google Tag Manager（全LP共通でCV計測。Vercelの環境変数にも同名で設定）
PUBLIC_GTM_ID=GTM-NC9FX82V

# Dialogflow CX Messenger（Vertex AI の会話エージェント）。秘密鍵ではない。
# 未設定のあいだチャット枠は出ない。値はコンソールの埋め込みコードからコピーする。
# 本番の入れ先は src/data/chatWidget.ts。Cloudflare のビルド変数画面は使わない。
# 下の3つはローカル確認用。空のときは chatWidget.ts の値を使う。
# PUBLIC_DIALOGFLOW_PROJECT_ID=
# PUBLIC_DIALOGFLOW_AGENT_ID=
# PUBLIC_DIALOGFLOW_LOCATION=global

# Decap CMS OAuth. Production reads these from Cloudflare
# Settings → ランタイム変数とシークレット (workers/cms-auth.js).
# Do not put them in this file. The other Settings block 「変数とシークレット」 is ignored at login.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Internal ads PDCA report (local only; do not commit real values)
# PDCA_SPREADSHEET_ID=
# PDCA_SPREADSHEET_GID=
# GOOGLE_SERVICE_ACCOUNT_JSON=
