{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static Astro site (output: "static"). Do NOT run `npx astro add cloudflare`
  // or install @astrojs/cloudflare — that adapter is for SSR only and will break
  // this project. Pages are pre-built into dist/; the Worker handles www→apex,
  // HTTP→HTTPS, old LPO path 301s, workers.dev noindex, and /api/* OAuth.
  "name": "carclean0511",
  "account_id": "6e757bcffbbc2c6d612e923c5644e865",
  "main": "workers/github-oauth.js",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    // Apex HTTPS is live. 301 HTTP → HTTPS (www/path folded into the same hop).
    "FORCE_HTTPS": "true"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "carinteriorcleaning.jp",
      "custom_domain": true,
      "zone_id": "bd167301fa6612490ed06067eb4614fe"
    },
    {
      "pattern": "www.carinteriorcleaning.jp",
      "custom_domain": true,
      "zone_id": "bd167301fa6612490ed06067eb4614fe"
    }
  ]
}
