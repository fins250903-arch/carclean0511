{
  // Static Astro site (output: "static") — do NOT add @astrojs/cloudflare.
  // That adapter is only for SSR / on-demand rendering and is what Cloudflare
  // tried to auto-install when this file was missing.
  //
  // `main` only serves Decap CMS GitHub OAuth (`/api/auth`, `/api/callback`).
  // Every other request stays on static assets, including `_redirects`.
  // Runtime secrets: Settings → ランタイム変数とシークレット (not 「変数とシークレット」).
  //   GITHUB_CLIENT_ID
  //   GITHUB_CLIENT_SECRET
  "name": "carclean0511",
  "main": "./workers/cms-auth.js",
  "compatibility_date": "2026-09-19",
  // Dashboard plaintext vars are wiped by `wrangler deploy` unless this is true.
  // Secrets are kept either way. Required so GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET
  // entered under Settings → ランタイム変数とシークレット survive the next Git build.
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  }
}
