---
import type { BlogInternalLink } from '../../lib/blogInternalLinks';

interface Props {
  links: BlogInternalLink[];
  heading?: string;
}

const { links, heading = 'このトラブルの料金・手順を詳しく見る' } = Astro.props;
---

{links.length > 0 && (
  <nav
    id="post-related-lp"
    aria-label="関連ページ"
    class="not-prose mt-12 rounded-2xl border border-gray-200 bg-gray-50 p-6"
  >
    <h2 class="mb-4 text-lg font-bold text-gray-900">{heading}</h2>
    <ul class="space-y-3">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="block rounded-xl border border-gray-200 bg-white px-4 py-3 transition-colors hover:border-blue-300 hover:bg-blue-50"
          >
            <span class="block font-bold text-blue-700">{link.label}</span>
            <span class="mt-0.5 block text-sm leading-relaxed text-gray-600">{link.description}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
