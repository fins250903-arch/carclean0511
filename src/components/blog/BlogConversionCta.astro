---
import { LINE_URL, TEL } from '../../lib/site';
import type { BlogAnswerFirst } from '../../lib/blogAnswerFirst';

interface Props {
  answer: BlogAnswerFirst;
  compact?: boolean;
}

const { answer, compact = false } = Astro.props;
const topic = answer.trouble ?? '車内の汚れとニオイ';
const place = answer.area ?? '対応エリア';
const measured = [answer.price, answer.workTime].filter(Boolean).join('・');
---

<section
  class:list={[
    'not-prose rounded-2xl border border-red-100 bg-red-50 text-center shadow-sm',
    compact ? 'mt-4 p-5' : 'mt-16 p-8',
  ]}
  aria-label="無料見積もり"
>
  <h2 class:list={['font-bold text-gray-900', compact ? 'text-lg mb-2' : 'text-2xl mb-4']}>
    {place}の{topic}、写真で当日見積もり
  </h2>
  <p class:list={['text-gray-700', compact ? 'mb-4 text-sm' : 'mb-8']}>
    {measured
      ? `この事例の実測は${measured}。同じ症状なら写真を送っていただければ当日中に目安をお返しします。`
      : '嘔吐・おもらし・ペットの粗相など、放置すると悪化するトラブルに最短即日で出張対応します。'}
  </p>

  <div class="flex flex-col sm:flex-row justify-center gap-4 mb-3">
    <a
      href={LINE_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="bg-[#06C755] hover:bg-[#05a346] !text-white font-bold py-4 px-8 rounded-full shadow-lg text-lg transition-transform hover:scale-105 flex items-center justify-center gap-2"
    >
      LINEで無料見積もり
    </a>
    <a
      href={`tel:${TEL}`}
      class="bg-red-600 hover:bg-red-700 !text-white font-bold py-4 px-8 rounded-full shadow-lg text-lg transition-transform hover:scale-105 flex items-center justify-center gap-2"
    >
      📞 {TEL} に電話する
    </a>
  </div>
  {!compact && <p class="text-sm text-gray-500">※お急ぎの場合はお電話が確実です。</p>}
</section>
