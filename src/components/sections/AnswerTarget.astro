---
import { formatContentFreshnessJa } from '../../lib/structuredDataConstants';
import { LINE_URL, TEL } from '../../lib/site';

interface Props {
  text: string;
  points?: string[];
  /** Voice / emergency search line (AIO speakable) */
  voiceLine?: string;
}

const { text, points = [], voiceLine } = Astro.props;
const contentUpdated = formatContentFreshnessJa();
---

<section id="answer-target" aria-label="緊急時の結論" class="border-b border-green-200 bg-green-50 py-4 sm:py-6">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <p class="mb-2 text-xs font-bold tracking-wide text-blue-700">
      最終更新：{contentUpdated}
    </p>
    {voiceLine && (
      <p class="speakable-voice mb-3 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm font-semibold leading-snug text-red-700 md:text-base">
        {voiceLine}
      </p>
    )}
    <div class="answer-lead rounded-xl border border-green-300 bg-white p-4 text-left text-sm font-medium leading-relaxed text-gray-800 shadow-sm md:p-5 md:text-base">
      <p>{text}</p>
      {points.length > 0 && (
        <ul class="mt-3 list-inside list-disc space-y-1.5 text-sm text-gray-700 md:text-base">
          {points.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      )}
      {/* スマホはフッターCTAがあるため控えめ。PCのみ大きめボタン */}
      <p class="mt-3 text-sm font-bold text-gray-800 md:hidden">
        お急ぎの方は<span class="text-red-600">画面下のLINE・電話</span>からどうぞ
      </p>
      <div class="mt-3 hidden gap-2 sm:flex-row md:flex">
        <a
          href={`tel:${TEL}`}
          class="inline-flex items-center justify-center rounded-lg bg-red-600 px-4 py-2.5 text-sm font-black text-white shadow-sm hover:bg-red-700"
        >
          電話で空き確認 {TEL}
        </a>
        <a
          href={LINE_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-lg bg-[#06C755] px-4 py-2.5 text-sm font-black text-white shadow-sm hover:bg-[#05a346]"
        >
          LINEで写真見積もり
        </a>
      </div>
    </div>
  </div>
</section>
