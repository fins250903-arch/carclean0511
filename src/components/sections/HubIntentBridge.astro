---
/**
 * Ads sometimes land passenger keywords on region/truck hubs.
 * Surface price + correct intent links near the fold for LPE.
 */
import { CAR_PRICING, TRUCK_PRICING, yen } from '../../data/pricingConstants';
import { regionPath } from '../../lib/niche';
import type { ServiceNiche } from '../../lib/niche';
import { LINE_URL } from '../../lib/site';

interface Props {
  regionId: string;
  displayName: string;
  niche: ServiceNiche;
}

const { regionId, displayName, niche } = Astro.props;
const carPath = regionPath(regionId, 'car');
const interiorPath = `${carPath.replace(/\/$/, '')}/interior-cleaning/`;
const odorPath = `${carPath.replace(/\/$/, '')}/kuruma-nioi-keshi/`;
const seatPath = `${carPath.replace(/\/$/, '')}/seat-cleaning/`;
---

{
  niche === 'truck' ? (
    <section
      id="hub-intent-bridge"
      aria-label="トラックキャビン清掃の料金目安と乗用車への案内"
      class="border-b border-amber-100 bg-gradient-to-b from-amber-50/90 to-white"
    >
      <div class="container mx-auto max-w-5xl px-4 py-5 md:py-6">
        <p class="mb-3 text-center text-sm font-bold text-amber-950 md:text-base">
          {displayName}のトラック・キャビン清掃 — 料金目安と、乗用車の方へのご案内
        </p>
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-3 sm:gap-3">
          <div class="rounded-xl border border-amber-200/80 bg-white px-4 py-3 text-center shadow-sm">
            <p class="text-[11px] font-bold tracking-wide text-amber-800">2tキャビン目安</p>
            <p class="mt-1 text-base font-black text-gray-900 md:text-lg">{yen(TRUCK_PRICING.ton2Cab)}〜</p>
          </div>
          <div class="rounded-xl border border-amber-200/80 bg-white px-4 py-3 text-center shadow-sm">
            <p class="text-[11px] font-bold tracking-wide text-amber-800">4t（キャビン＋ベッド）</p>
            <p class="mt-1 text-base font-black text-gray-900 md:text-lg">{yen(TRUCK_PRICING.ton4Total)}〜</p>
          </div>
          <div class="rounded-xl border border-amber-200/80 bg-white px-4 py-3 text-center shadow-sm">
            <p class="text-[11px] font-bold tracking-wide text-amber-800">所要の目安</p>
            <p class="mt-1 text-base font-black text-gray-900 md:text-lg">約2〜4時間</p>
          </div>
        </div>
        <p class="mt-4 text-center text-sm text-gray-700">
          乗用車の車内掃除・消臭・シート洗浄でお越しの方は、専用ページへどうぞ。
        </p>
        <div class="mt-2 flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:justify-center">
          <a
            href={interiorPath}
            class="inline-flex items-center justify-center rounded-xl bg-blue-800 px-4 py-2.5 text-sm font-bold text-white hover:bg-blue-900"
          >
            乗用車の車内クリーニング
          </a>
          <a
            href={odorPath}
            class="inline-flex items-center justify-center rounded-xl border-2 border-blue-800 px-4 py-2.5 text-sm font-bold text-blue-900 hover:bg-blue-50"
          >
            車の匂い消し・消臭
          </a>
          <a
            href={seatPath}
            class="inline-flex items-center justify-center rounded-xl border-2 border-blue-800 px-4 py-2.5 text-sm font-bold text-blue-900 hover:bg-blue-50"
          >
            車シートクリーニング
          </a>
          <a
            href={LINE_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-xl bg-[#06C755] px-4 py-2.5 text-sm font-bold text-white hover:bg-[#05b34c]"
          >
            LINEで写真見積もり
          </a>
        </div>
      </div>
    </section>
  ) : niche === 'car' ? (
    <section
      id="hub-intent-bridge"
      aria-label="車内クリーニングの料金目安"
      class="border-b border-blue-100 bg-gradient-to-b from-blue-50/80 to-white"
    >
      <div class="container mx-auto max-w-5xl px-4 py-5 md:py-6">
        <p class="mb-3 text-center text-sm font-bold text-blue-900 md:text-base">
          {displayName}の出張車内クリーニング — 広告経由の方も、料金とメニューがすぐ分かります
        </p>
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-3 sm:gap-3">
          <div class="rounded-xl border border-blue-200/80 bg-white px-4 py-3 text-center shadow-sm">
            <p class="text-[11px] font-bold tracking-wide text-blue-700">基本洗浄（税込）</p>
            <p class="mt-1 text-base font-black text-gray-900 md:text-lg">
              軽自動車 {yen(CAR_PRICING.lightBasic)}〜
            </p>
          </div>
          <div class="rounded-xl border border-blue-200/80 bg-white px-4 py-3 text-center shadow-sm">
            <p class="text-[11px] font-bold tracking-wide text-blue-700">消臭セット</p>
            <p class="mt-1 text-base font-black text-gray-900 md:text-lg">
              {yen(CAR_PRICING.lightDeodorize)}〜
            </p>
          </div>
          <div class="rounded-xl border border-blue-200/80 bg-white px-4 py-3 text-center shadow-sm">
            <p class="text-[11px] font-bold tracking-wide text-blue-700">所要・エリア</p>
            <p class="mt-1 text-base font-black text-gray-900 md:text-lg">約1.5〜3時間／出張費無料</p>
          </div>
        </div>
        <div class="mt-3 flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:justify-center">
          <a
            href={interiorPath}
            class="inline-flex items-center justify-center rounded-xl bg-blue-800 px-4 py-2.5 text-sm font-bold text-white hover:bg-blue-900"
          >
            通常の車内クリーニング詳細
          </a>
          <a
            href={odorPath}
            class="inline-flex items-center justify-center rounded-xl border-2 border-blue-800 px-4 py-2.5 text-sm font-bold text-blue-900 hover:bg-blue-50"
          >
            匂い消し・消臭の詳細
          </a>
          <a
            href="tel:070-8428-0866"
            class="inline-flex items-center justify-center rounded-xl bg-red-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-red-700"
          >
            電話で無料相談
          </a>
        </div>
      </div>
    </section>
  ) : null
}
