---
import { STORE_NAME, LINE_URL, TEL } from '../../lib/site';
import { IMG513 } from '../../lib/assets513';
import {
  TRUCK_PRICING,
  yen,
  carFvPriceHookMain,
  carFvPriceHookSub,
} from '../../data/pricingConstants';

interface AdHeroOverrides {
  subtitle: string;
  highlightLine1: string;
  highlightLine2: string;
  subcatch: string;
  fvImage: string;
  footerText: string;
  mainTitle?: string;
  /** KW意図に合わせたFV価格フック（未指定時は共通1シート〜） */
  priceHookMain?: string;
  priceHookSub?: string;
  priceHookNote?: string;
}

interface Props {
  regionName: string;
  displayName: string;
  niche?: 'car' | 'truck' | 'bus';
  adHero?: AdHeroOverrides;
  /** 地区トップLP向けクエリ整合H1（adHero未設定時） */
  mainTitle?: string;
  /** Override FV image only (Osaka subarea etc.) without switching to keyword adHero layout */
  fvImage?: string;
}

const { regionName, displayName, niche = 'car', adHero, mainTitle, fvImage: fvImageProp } = Astro.props;
const resolvedMainTitle = adHero?.mainTitle ?? mainTitle;
const isTruck = niche === 'truck';
const isBus = niche === 'bus';

const subtitle = adHero?.subtitle ?? (isTruck
    ? `${displayName}トラックキャビン清掃専門店/キャビン洗浄`
    : isBus
      ? `${displayName}バス車内清掃専門店/座席・通路洗浄`
      : `${displayName}車内クリーニング専門店/シート洗浄`);

const fvImage =
  adHero?.fvImage ??
  fvImageProp ??
  (isTruck ? "/images/truck-fv.png" : isBus ? "/images/kw/bus-fv.png" : IMG513.fvCar);

/** FV価格フック（広告CTR・クリック動機用）。車LPは常に「1シート 18,000円から」を主表示 */
const priceHookMain = adHero?.priceHookMain ?? (isTruck
  ? `2tキャビン ${yen(TRUCK_PRICING.ton2Cab)}〜`
  : isBus
    ? `バス座席洗浄 応相談`
    : carFvPriceHookMain());
const priceHookSub = adHero?.priceHookSub ?? (isTruck
  ? `4t合計 ${yen(TRUCK_PRICING.ton4Total)}〜｜税込`
  : isBus
    ? `運行スケジュールに合わせた出張対応｜税込見積`
    : carFvPriceHookSub());
const priceHookNote = adHero?.priceHookNote ?? (isTruck || isBus
  ? '※現車確認後に確定／追加費用は作業前にご説明'
  : '※座席単体の基本洗浄。嘔吐・灯油・強い臭いは消臭セット別途');

const gap = 'mb-2.5 max-md:mb-2 sm:mb-3';
const gapTight = 'mb-2 max-md:mb-1.5 sm:mb-2';
---

{/*
  スマホ特化FV:
  - 上部に写真を実ブロックで確保（隠れない）
  - 文字は写真の下。小さくしすぎない
  - 大きなCTAはフッター固定に任せ、画面内は控えめ
*/}
<section class="relative w-full overflow-hidden bg-white md:min-h-[88vh] md:flex md:items-start">
    {/* スマホ：上部写真帯（実寸）。PC：全画面背景 */}
    <div class="relative z-0 w-full max-md:h-[48vw] max-md:min-h-[12.5rem] max-md:max-h-[15.5rem] md:absolute md:inset-0 md:h-full">
        <img
            src={fvImage}
            alt={`${displayName}対応 ${STORE_NAME}`}
            class="h-full w-full object-cover object-[center_30%] md:object-[center_bottom] md:object-right"
            loading="eager"
            fetchpriority="high"
        />
        {/* スマホは下端だけ白へ馴染ませる。PCは左テキスト用グラデ */}
        <div
            class="pointer-events-none absolute inset-0 max-md:bg-gradient-to-t max-md:from-white max-md:via-white/20 max-md:to-transparent md:bg-gradient-to-r md:from-white/90 md:via-white/45 md:to-transparent"
            aria-hidden="true"
        ></div>
    </div>

    <div class="relative z-20 w-full px-3.5 pb-3 pt-1 sm:px-6 md:container md:mx-auto md:px-16 md:pb-8 md:pt-6">
        <div class="max-w-xl md:max-w-2xl">
            {/* 1. バッジ */}
            <div class:list={[gapTight, 'flex flex-wrap gap-1.5']}>
                <span class="inline-flex rounded-full bg-red-600 px-2.5 py-1 text-[13px] font-bold text-white shadow-md sm:px-4 sm:py-1.5 sm:text-sm md:text-base">
                    ３６５日２４時間受付中
                </span>
                <span class="inline-flex rounded-full bg-blue-900 px-2.5 py-1 text-[13px] font-bold text-white shadow-md sm:px-4 sm:py-1.5 sm:text-sm md:text-base">
                    "出張"車内クリーニング業者
                </span>
            </div>

            {/* 2. 小見出し */}
            {adHero ? (
                <p class:list={[gap, 'inline-block max-w-full border-b-[3px] border-blue-600 pr-1 text-[1.05rem] font-black leading-snug tracking-tight text-gray-900 sm:text-2xl md:text-3xl']}>
                    {subtitle}
                </p>
            ) : (
                <p class:list={[gap, 'text-[0.95rem] font-bold leading-snug text-gray-800 sm:text-base md:text-xl']}>
                    {subtitle}
                </p>
            )}

            {/* 3. メインキャッチ — 読みやすさ優先（縮小しすぎない） */}
            <h1 class:list={[
                gap,
                'font-black leading-[1.22] tracking-tight text-blue-900',
                resolvedMainTitle
                    ? 'text-[clamp(1.4rem,5.4vw,2.4rem)] md:text-4xl lg:text-5xl'
                    : adHero
                        ? 'text-[clamp(1.6rem,6.8vw,3.1rem)] md:text-7xl lg:text-8xl'
                        : 'text-[clamp(1.9rem,8.8vw,6rem)] md:text-7xl lg:text-8xl',
            ]}>
                {resolvedMainTitle ? (
                    <span class="block max-w-[98%] font-black leading-tight">{resolvedMainTitle}</span>
                ) : (
                    <>
                        <span class="block">早急に解決！</span>
                        <span class="block">特急便</span>
                    </>
                )}
            </h1>

            {/* 4. 赤帯 */}
            <div class:list={[gap, 'inline-block max-w-full rounded-xl bg-red-600 px-3 py-2.5 shadow-lg sm:rounded-2xl sm:px-5 sm:py-2.5']}>
                <p class="text-[clamp(1.25rem,5vw,1.75rem)] font-black leading-snug tracking-wide text-white sm:text-xl md:text-3xl">
                    {adHero ? (
                        <>
                            <span class="whitespace-nowrap">{adHero.highlightLine1}</span><wbr /><span class="whitespace-nowrap">{adHero.highlightLine2}</span>
                        </>
                    ) : (
                        isBus ? (
                            <>
                                <span class="whitespace-nowrap">バス座席の嘔吐、</span><wbr /><span class="whitespace-nowrap">通路のにおい、</span><wbr /><span class="whitespace-nowrap">灯油こぼし</span>
                            </>
                        ) : (
                            <>
                                <span class="whitespace-nowrap">おうと（嘔吐）、</span><wbr /><span class="whitespace-nowrap">におい、</span><wbr /><span class="whitespace-nowrap">灯油こぼし</span>
                            </>
                        )
                    )}
                </p>
            </div>

            {/* 5. 価格フック — CTR核。大きく読みやすく */}
            <div class:list={[gap, 'w-full max-w-xl rounded-2xl border-[3px] border-amber-400 bg-gradient-to-r from-blue-950 via-blue-900 to-blue-950 px-3.5 py-3.5 text-white shadow-xl sm:px-5']}>
                <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                    <span class="shrink-0 rounded-md bg-amber-400 px-2 py-0.5 text-xs font-black text-blue-950">料金目安</span>
                    <span class="whitespace-nowrap text-[clamp(1.55rem,6.8vw,2.25rem)] font-black tracking-tight text-amber-300 sm:text-3xl md:text-4xl">
                        {priceHookMain}
                    </span>
                </div>
                <p class="mt-1.5 text-[1rem] font-bold leading-snug text-blue-50 sm:text-base md:text-lg">
                    {priceHookSub}
                </p>
                <p class="mt-1 text-xs font-medium leading-snug text-blue-100/90 sm:text-sm">
                    {priceHookNote}
                </p>
            </div>

            {/* 6. トップCTA
                スマホ: フッター固定CTAがあるため案内文のみ（過度なボタン重複を避ける）
                PC: 従来の大きめ2ボタンを表示 */}
            <div class:list={[gap, 'w-full max-w-xl']} data-cta-section="hero_top_cta">
                <div class="rounded-xl border border-blue-200 bg-blue-50/90 px-3 py-2.5 text-center md:hidden">
                    <p class="text-[1rem] font-black leading-snug text-gray-900">
                        ご相談・見積は<span class="text-red-600">画面下のボタン</span>から
                    </p>
                    <p class="mt-1 text-xs font-bold text-gray-600">
                        LINE写真見積／電話｜{displayName}エリア出張対応
                    </p>
                </div>

                <div class="hidden flex-col gap-3 md:flex">
                    <a
                        href={LINE_URL}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex w-full items-center justify-center gap-2 rounded-2xl bg-[#06C755] px-8 py-4 text-center text-xl font-black text-white shadow-xl transition-transform hover:scale-[1.02] hover:bg-[#05a346] md:text-2xl"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="currentColor" class="shrink-0" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
                        <span class="whitespace-nowrap">LINEで写真見積もり</span>
                        <span class="text-sm font-bold opacity-90 whitespace-nowrap">相談無料</span>
                    </a>
                    <a
                        href={`tel:${TEL}`}
                        class="flex w-full flex-col items-center justify-center gap-0.5 rounded-2xl bg-red-600 px-8 py-4 text-center text-xl font-black text-white shadow-xl ring-2 ring-red-300/80 transition-transform hover:scale-[1.02] hover:bg-red-700 sm:flex-row sm:gap-2 md:text-2xl"
                    >
                        <span class="whitespace-nowrap">今すぐ電話 {TEL}</span>
                        <span class="text-sm font-bold opacity-95 whitespace-nowrap">お急ぎの方は電話</span>
                    </a>
                    <p class="inline-block rounded-md bg-white/70 px-2 py-1 text-xs font-bold leading-snug text-gray-800 shadow-sm md:text-sm">
                        作業前見積／追加料金は事前説明後のみ／{displayName}エリア出張対応
                    </p>
                </div>
            </div>

            {/* 7. キャンペーン */}
            <div class:list={[gap, 'inline-block w-full max-w-xl rounded-2xl border-[3px] border-yellow-400 bg-yellow-100 p-3 shadow-lg sm:rounded-3xl sm:border-4 sm:p-4 md:p-5']}>
                <p class="mb-0.5 text-[0.95rem] font-bold leading-tight text-gray-800 sm:text-base md:text-lg">
                    <span class="whitespace-nowrap">今月末まで、</span><wbr /><span class="whitespace-nowrap">通常2,000円の</span>
                </p>
                <p class="text-[1.4rem] font-black leading-[1.1] text-red-600 sm:text-3xl md:text-5xl">
                    <span class="whitespace-nowrap">抗菌コート</span><wbr /> <span class="whitespace-nowrap">無料！</span>
                </p>
            </div>

            {/* 8. サブキャッチ */}
            <p class:list={[gap, 'inline-block max-w-full rounded-md bg-white/90 px-2.5 py-1.5 text-[1rem] font-bold leading-snug text-gray-800 sm:text-base md:text-2xl']}>
                {adHero ? (
                    <span>{adHero.subcatch}</span>
                ) : (
                    isBus ? (
                        <>
                            <span class="whitespace-nowrap">{displayName}の</span><wbr /><span class="whitespace-nowrap">バス・マイクロバス</span><wbr /><span class="whitespace-nowrap">車内清掃・消臭洗浄</span>
                        </>
                    ) : (
                        <>
                            <span class="whitespace-nowrap">{displayName}の</span><wbr /><span class="whitespace-nowrap">車内クリーニング・</span><wbr /><span class="whitespace-nowrap">消臭洗浄</span>
                        </>
                    )
                )}
            </p>

            {/* 9. 緊急対応テキスト */}
            <p class:list={[gap, 'inline-block max-w-full rounded-lg bg-white/90 px-2.5 py-2 text-[1rem] font-black leading-snug text-gray-800 sm:px-4 sm:text-base md:text-xl']}>
                {adHero ? (
                    <span>{adHero.footerText}</span>
                ) : (
                    isBus ? (
                        <>
                            <span class="whitespace-nowrap">バス座席の嘔吐・灯油の</span><wbr /><span class="whitespace-nowrap">緊急トラブル</span> <span class="whitespace-nowrap text-red-600 underline decoration-4">即日対応</span><wbr /> <span class="whitespace-nowrap">お伺いします</span>
                        </>
                    ) : (
                        <>
                            <span class="whitespace-nowrap">嘔吐・灯油こぼしの</span><wbr /><span class="whitespace-nowrap">緊急トラブル</span> <span class="whitespace-nowrap text-red-600 underline decoration-4">すぐ対応</span><wbr /> <span class="whitespace-nowrap">お伺いします</span>
                        </>
                    )
                )}
            </p>

            {/* 10. ディーラー比較 */}
            <div class="w-full max-w-xl rounded-lg border-2 border-red-500 bg-white/95 p-3 shadow-md sm:border-4 sm:p-4 md:p-5">
                <p class="mb-0.5 text-[0.95rem] font-bold leading-tight text-gray-800 sm:text-base md:text-xl">
                    <span class="whitespace-nowrap">ディーラーで</span><wbr /><span class="whitespace-nowrap">5日待てますか？</span>
                </p>
                <p class="text-[1.4rem] font-black leading-none text-red-600 sm:text-3xl md:text-5xl">
                    絶対ムリ！
                </p>
            </div>
        </div>
    </div>
</section>
