---
import type { IntentGuideBlock } from '../../data/adLpIntentGuides';

interface Props {
  block: IntentGuideBlock;
}

const { block } = Astro.props;
const hasHint = Boolean(block.columns[2]);
---

<section class="py-10 bg-white border-b border-slate-200" aria-label="意図別の比較・診断ガイド">
  <div class="px-4 mx-auto max-w-4xl sm:px-6 lg:px-8">
    <h2 class="text-xl md:text-2xl font-bold text-gray-900 mb-2 text-center">
      {block.title}
    </h2>
    <p class="text-sm text-gray-600 text-center mb-6 leading-relaxed">
      {block.lead}
    </p>
    <div class="overflow-x-auto rounded-xl border border-gray-200 shadow-sm bg-white">
      <table class="min-w-full divide-y divide-gray-200 text-sm md:text-base">
        <thead class="bg-slate-50">
          <tr>
            <th scope="col" class="px-4 py-3 text-left font-bold text-gray-700">{block.columns[0]}</th>
            <th scope="col" class="px-4 py-3 text-left font-bold text-gray-700">{block.columns[1]}</th>
            {hasHint && (
              <th scope="col" class="px-4 py-3 text-left font-bold text-blue-700 bg-blue-50">{block.columns[2]}</th>
            )}
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          {block.rows.map((row) => (
            <tr>
              <td class="px-4 py-3 font-medium text-gray-900 whitespace-nowrap align-top">{row.label}</td>
              <td class="px-4 py-3 text-gray-700 align-top">{row.detail}</td>
              {hasHint && (
                <td class="px-4 py-3 text-blue-800 bg-blue-50 font-medium align-top whitespace-nowrap">{row.hint}</td>
              )}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {block.note && (
      <p class="mt-4 text-xs text-gray-500 leading-relaxed text-center md:text-left">
        ※{block.note}
      </p>
    )}
  </div>
</section>
