---
import { LINE_URL, TEL } from '../../lib/site';
import { CAR_PRICING, TRUCK_PRICING, yen } from '../../data/pricingConstants';

interface Props {
  displayName: string;
  niche?: 'car' | 'truck' | 'bus';
  /** e.g. 消臭セット 26,000円〜 */
  priceLabel?: string;
  /** Work-time line only. Reception and arrival are labeled separately. */
  durationLabel?: string;
  /** e.g. 大阪市内・北摂ほか出張費無料 */
  areaLabel?: string;
  /** Short intent line matching the ad keyword */
  intentLabel?: string;
}

const {
  displayName,
  niche = 'car',
  priceLabel,
  durationLabel,
  areaLabel = `${displayName}へ出張費無料`,
  intentLabel,
} = Astro.props;

const resolvedIntent = intentLabel
  ?? (niche === 'truck' ? 'トラックキャビン清掃' : niche === 'bus' ? 'バス車内清掃' : '出張車内クリーニング');

const resolvedPrice = priceLabel
  ?? (niche === 'truck'
    ? `2tキャビン ${yen(TRUCK_PRICING.ton2Cab)}〜`
    : niche === 'bus'
      ? '2連席1区画 22,000円〜'
      : `1シート ${yen(CAR_PRICING.seatSingleBasic)}から／軽自動車 ${yen(CAR_PRICING.lightBasic)}〜`);

const resolvedWork = durationLabel
  ? (durationLabel.startsWith('作業') || durationLabel.startsWith('1区画') ? durationLabel : `作業 ${durationLabel}`)
  : (niche === 'bus' ? '1区画 約1.5〜2.5時間' : '作業 1.5〜3時間');
---

<section
  id="ad-lp-quick-facts"
  aria-label="料金・所要時間・対応エリアの目安"
  class="border-b border-blue-100 bg-gradient-to-b from-blue-50/80 to-white"
>
  <div class="container mx-auto max-w-5xl px-4 py-5 md:py-6">
    <p class="mb-3 text-center text-sm font-bold text-blue-900 md:text-base">
      {displayName}の{resolvedIntent} — 料金・受付・到着がすぐ分かります
    </p>
    <div class="grid grid-cols-1 gap-2 sm:grid-cols-3 sm:gap-3">
      <div class="rounded-xl border border-blue-200/80 bg-white px-4 py-3 text-center shadow-sm">
        <p class="text-[11px] font-bold tracking-wide text-blue-700">料金目安（税込）</p>
        <p class="mt-1 text-base font-black leading-snug text-gray-900 md:text-lg">{resolvedPrice}</p>
      </div>
      <div class="rounded-xl border border-blue-200/80 bg-white px-4 py-3 text-center shadow-sm">
        <p class="text-[11px] font-bold tracking-wide text-blue-700">時間の目安</p>
        <p class="mt-1 text-sm font-black leading-snug text-gray-900 md:text-base">受付 365日24時間</p>
        <p class="text-sm font-bold leading-snug text-gray-800">到着 空き次第で当日〜翌朝</p>
        <p class="text-sm font-bold leading-snug text-gray-700">{resolvedWork}</p>
      </div>
      <div class="rounded-xl border border-blue-200/80 bg-white px-4 py-3 text-center shadow-sm">
        <p class="text-[11px] font-bold tracking-wide text-blue-700">対応エリア</p>
        <p class="mt-1 text-base font-black leading-snug text-gray-900 md:text-lg">{areaLabel}</p>
      </div>
    </div>
    <p class="mt-3 text-center text-sm font-bold leading-relaxed text-gray-800">
      LINE写真で概算無料 → 現場で作業前に確定 → 了承後だけ施工
    </p>
    <div class="mt-3 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-center">
      <a
        href={`tel:${TEL}`}
        class="inline-flex items-center justify-center whitespace-normal rounded-xl bg-red-600 px-5 py-3 text-center text-sm font-black text-white shadow-md transition hover:bg-red-700"
      >
        今すぐ電話（{TEL}）
      </a>
      <a
        href={LINE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-xl bg-[#06C755] px-5 py-3 text-sm font-black text-white shadow-md transition hover:bg-[#05b34c]"
      >
        LINEで写真見積もり
      </a>
      <a
        href="#pricing"
        class="inline-flex items-center justify-center rounded-xl border border-blue-300 bg-white px-5 py-3 text-sm font-bold text-blue-900 shadow-sm transition hover:bg-blue-50"
      >
        詳しい料金表を見る
      </a>
    </div>
  </div>
</section>
