---
import { dedupeFaqItems, faqData, truckFaqData, busFaqData, type FAQItem } from '../../data/seoData';
import { rewriteTravelFeeText } from '../../data/pricingConstants';
import type { ServiceNiche } from '../../lib/niche';
import { rewriteFaqForRegion } from '../../lib/powerPolicy';
import { mentionsJapanesePlace } from '../../lib/placeNames';

interface Props {
  niche?: ServiceNiche;
  extraFaqs?: FAQItem[];
  regionName?: string;
  /** Nationwide page: drop place-specific items and repeated questions. */
  omitPlaceNames?: boolean;
}

const { niche = 'car', extraFaqs = [], regionName, omitPlaceNames = false } = Astro.props;

const baseFaqs =
  niche === 'truck' ? truckFaqData : niche === 'bus' ? busFaqData : faqData;

const mapped = dedupeFaqItems(
  [...baseFaqs, ...extraFaqs].map((faq) => {
    const withTravel = { ...faq, a: rewriteTravelFeeText(faq.a, regionName) };
    return rewriteFaqForRegion(withTravel, regionName);
  }),
);

const seen = new Set<string>();
const faqs = omitPlaceNames
  ? mapped.filter((faq) => {
      if (mentionsJapanesePlace(faq.q) || mentionsJapanesePlace(faq.a)) return false;
      const key = faq.q.replace(/\s/g, '');
      if (seen.has(key)) return false;
      seen.add(key);
      return true;
    })
  : mapped;
---

<section class="py-10 bg-gray-50" id="faq">
    <div class="container mx-auto px-8">
        <h2 class="text-3xl font-bold text-center text-gray-800 mb-12">
            よくあるご質問
        </h2>

        <div class="max-w-3xl mx-auto space-y-4">
            {faqs.map((faq) => (
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="p-6">
                        <div class="flex items-start gap-4">
                            <span class="w-8 h-8 bg-primary text-white rounded-lg flex items-center justify-center font-bold flex-shrink-0">Q</span>
                            <h3 class="text-lg font-bold text-gray-800 mt-1">{faq.q}</h3>
                        </div>
                        <div class="mt-4 pl-12 flex items-start gap-4 border-t border-gray-50 pt-4">
                            <span class="w-8 h-8 bg-accent text-white rounded-lg flex items-center justify-center font-bold flex-shrink-0">A</span>
                            <p class="text-gray-600 leading-relaxed mt-1">
                                {faq.a}
                            </p>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>
