---
import { buildMobileInteriorCleaningDefinition, formatContentFreshnessJa } from '../../lib/structuredDataConstants';
import { CAR_PRICING, TRUCK_PRICING, carComparisonPriceSummary, yen } from '../../data/pricingConstants';
import { buildAioContentFaqs } from '../../data/aioKeywordContent';
import type { FAQItem } from '../../data/seoData';

interface Props {
  regionName: string;
  niche?: 'car' | 'truck' | 'bus';
  /** 出張 車内 清掃 専門LP向けの見出し・定義の強調 */
  focusShutchou?: boolean;
  /** Answer-First block for AIO (keyword LP) */
  answerFirst?: string;
  /** Override default definition sentence */
  customDefinition?: string;
  /** 保険判断表・拡張FAQ（乗用車LP向け） */
  showAioExtensions?: boolean;
  /** 嘔吐4日ルール等の緊急教育ブロック（Ads非緊急KWではOFF） */
  showVomitEducation?: boolean;
  /** 追加FAQ（キーワードLP用） */
  extraFaqs?: FAQItem[];
  /** Bottom FAQ.astro already lists these questions. Keep false on ad LPs. */
  showInlineFaq?: boolean;
}

const {
  regionName,
  niche = 'car',
  focusShutchou = false,
  answerFirst,
  customDefinition,
  showAioExtensions = true,
  showVomitEducation = true,
  extraFaqs = [],
  showInlineFaq = false,
} = Astro.props;
const isTruck = niche === 'truck';
const isBus = niche === 'bus';

const contentUpdated = formatContentFreshnessJa();

// AIOスニペット用「定義文」（出張 車内 清掃）
const aioDefinition = customDefinition
  ?? (isTruck
    ? `${regionName}のトラックキャビン清掃とは、プロの温水リンサーと特殊アルカリ電解水で、仮眠ベッドや天井に染みたタバコ・体臭を抽出する出張洗浄です。受付は365日24時間、到着は空き次第で当日〜翌朝です。2tキャビンは${yen(TRUCK_PRICING.ton2Cab)}〜（税込）が起点です。`
    : isBus
      ? `${regionName}の出張バス車内清掃とは、車庫や指定の駐車場で、嘔吐や尿漏れのあった座席区画を抽出洗浄するサービスです。受付は365日24時間、到着は運行の合間に合わせます。2連席1区画は22,000円〜（税込）が起点です。`
      : buildMobileInteriorCleaningDefinition(regionName));

const insuranceRows = [
  {
    situation: '自分の車を自分や家族が汚した',
    insurance: '車両保険（一般型）',
    note: '免責や等級への影響は契約次第',
    support: '見積もり時に、自己負担の目安も一緒に確認',
  },
  {
    situation: '他人の車を汚した（友人・同乗者）',
    insurance: '個人賠償責任保険',
    note: '等級に影響しない契約が多い',
    support: '施工報告書・写真・見積書を発行',
  },
  {
    situation: 'カーシェア・レンタカー',
    insurance: '基本は自己負担（実費とNOC）',
    note: '規約で保険の対象外になることが多い',
    support: '領収書を発行。到着は空き次第',
  },
];

const sectionTitle = isTruck
  ? `${regionName}のトラックキャビン清掃とは？`
  : focusShutchou
    ? `${regionName}で今すぐ頼める出張車内清掃とは？`
    : `${regionName}の車内クリーニングとは？｜近くの車内掃除業者を探す方へ`;

const serviceTarget = isTruck ? "大型トラック・バス" : "普通車（シート等）";
const defaultPrice = isTruck
  ? `${yen(TRUCK_PRICING.ton2Cab)}〜`
    : isBus
    ? '2連席1区画 22,000円〜'
    : `${yen(CAR_PRICING.seatSingleBasic)}〜（1シート）／軽自動車 ${yen(CAR_PRICING.lightBasic)}〜`;
const comparisonPriceLine = isTruck || isBus ? defaultPrice : carComparisonPriceSummary();

const comparisonRows = [
  {
    item: '対応方法',
    ours: 'プロ機材による抽出洗浄',
    dealer: 'シート・内装の新品交換',
  },
  {
    item: '費用の目安',
    ours: isTruck || isBus ? defaultPrice : comparisonPriceLine,
    dealer: '約20万円〜70万円（交換の事例）',
  },
  {
    item: '作業のタイミング',
    ours: '受付は365日24時間。到着は空き次第で当日〜翌朝。作業そのものは数時間',
    dealer: '数週間〜1ヶ月（部品取り寄せ）',
  },
  {
    item: '車両の移動',
    ours: '不要（ご自宅・会社・車庫へ出張）',
    dealer: '店舗への持ち込みが必要',
  },
];

const aioFaqs = buildAioContentFaqs(regionName, {
  includeExtended: showAioExtensions && !isTruck,
  extraFaqs,
});
---

<section id="aio-content" class="py-12 bg-white sm:py-16 lg:py-20 border-b border-gray-100">
  <div class="px-4 mx-auto max-w-7xl sm:px-6 lg:px-8">
    
    {/* 1. Answer-First + 定義文 (AIO Snippet) */}
    <div class="max-w-3xl mx-auto mb-12 text-center">
      <p class="text-xs font-bold text-blue-700 tracking-wide uppercase mb-3">
        最終更新：{contentUpdated}｜料金・対応エリア・施工事例を継続更新中
      </p>
      {answerFirst && (
        <p class="answer-lead text-base md:text-lg text-gray-800 leading-relaxed font-medium bg-green-50 p-5 md:p-6 rounded-xl border border-green-200 shadow-sm text-left mb-6">
          {answerFirst}
        </p>
      )}
      <h2 class="text-2xl font-bold text-gray-900 sm:text-3xl lg:text-4xl mb-4">
        {sectionTitle}
      </h2>
      <p class="text-lg text-gray-700 leading-relaxed font-medium bg-blue-50 p-4 rounded-xl border border-blue-100 shadow-sm text-left sm:p-6">
        <strong>定義：</strong>{aioDefinition}
      </p>
    </div>

    {!isTruck && !isBus && (
      <div class="mx-auto mb-10 grid max-w-4xl grid-cols-1 gap-3 sm:grid-cols-2">
        <article class="rounded-2xl border border-amber-200 bg-amber-50 p-4">
          <h3 class="text-base font-black leading-snug text-gray-900">お子さまの嘔吐で、今日も車を使いたい方へ</h3>
          <ul class="mt-2 space-y-1 text-sm leading-snug text-gray-800">
            <li><strong>受付</strong>は365日24時間。写真を送れば、作業前の相談は無料です。</li>
            <li><strong>到着</strong>は空き次第で当日〜翌朝。作業はおおむね1.5〜3時間です。</li>
            <li><strong>料金の起点</strong>は座席1脚 {yen(CAR_PRICING.seatSingleBasic)}（税込）。染みる前の抽出が、臭いの戻りを抑えます。</li>
          </ul>
        </article>
        <article class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
          <h3 class="text-base font-black leading-snug text-gray-900">中古車や同乗者のタバコ臭が気になる方へ</h3>
          <ul class="mt-2 space-y-1 text-sm leading-snug text-gray-800">
            <li>天井のヤニは、芳香剤では数日で戻ることが多いです。</li>
            <li>写真を見れば、落ちる範囲を作業前にお伝えします。</li>
            <li>完全な無臭はお約束できません。気にならないところまで改善するのが、おおよそ7〜8割です。</li>
          </ul>
        </article>
      </div>
    )}

    {/* 2. 構造化された論理的コンテンツ (H2/H3構造) */}
    <div class="max-w-4xl mx-auto space-y-12">
      
      {/* 比較表 */}
      <article>
        <h3 class="text-xl font-bold text-gray-900 border-l-4 border-blue-600 pl-4 mb-6">
          ディーラーと専門業者のコスト・対応比較
        </h3>
        <p class="text-gray-600 mb-4">
          ディーラーや一般的な整備工場では「部品交換」が基本となるため、高額かつ長期間の預かりになるケースがほとんどです。当店の「出張洗浄」との違いをご覧ください。
        </p>
        <div class="space-y-3 md:hidden">
          {comparisonRows.map((row) => (
            <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
              <p class="text-sm font-black text-gray-900">{row.item}</p>
              <p class="mt-2 text-sm font-bold leading-snug text-blue-800">当店：{row.ours}</p>
              <p class="mt-1 text-sm leading-snug text-gray-600">ディーラー交換：{row.dealer}</p>
            </div>
          ))}
        </div>
        <div class="hidden overflow-x-auto rounded-lg border border-gray-200 shadow-sm md:block">
          <table class="min-w-full divide-y divide-gray-200 text-sm md:text-base">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-4 py-3 text-left font-bold text-gray-700">比較項目</th>
                <th scope="col" class="bg-blue-50 px-4 py-3 text-left font-bold text-blue-700">当店（専門出張洗浄）</th>
                <th scope="col" class="px-4 py-3 text-left font-bold text-gray-700">メーカーディーラー（交換）</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
              {comparisonRows.map((row) => (
                <tr>
                  <td class="px-4 py-3 font-medium text-gray-900">{row.item}</td>
                  <td class="bg-blue-50 px-4 py-3 font-bold text-blue-800">{row.ours}</td>
                  <td class="px-4 py-3 text-gray-600">{row.dealer}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {!isTruck && !isBus && (
          <p class="mt-2 text-xs leading-snug text-gray-500">基本洗浄は通常の清掃、消臭セットは嘔吐・灯油・ペット臭などの脱臭を含みます。税込です。</p>
        )}
      </article>

      {!isTruck && showVomitEducation && (
        <article>
          <h3 class="text-xl font-bold text-gray-900 border-l-4 border-blue-600 pl-4 mb-4">
            なぜ「4日以内」の洗浄が必要なのか（嘔吐の4日ルール）
          </h3>
          <p class="text-gray-700 leading-relaxed mb-4">
            車内で嘔吐したあとは、<strong>目安として4日以内の抽出洗浄</strong>をおすすめしています。<br/>
            胃酸や食べかすがシートのウレタンに染みると、日が経つほど酸っぱい臭いが戻りやすくなります。市販の消臭スプレーは表面の香りで覆うだけで、繊維の奥に残った原因は取れません。
          </p>
          <p class="text-gray-700 leading-relaxed">
            当店では、専用のアルカリ電解水で酸性の嘔吐物を中和し、<strong>約40℃の温水リンサー（吸引洗浄機）</strong>で繊維の奥から汚れを抽出。さらに<strong>100℃の高温スチーム</strong>で除菌・脱臭し、ニオイの「元を絶つ」ため、徹底的に臭いを除去することが可能です。
          </p>
        </article>
      )}

      {!isTruck && !showVomitEducation && (
        <article>
          <h3 class="text-xl font-bold text-gray-900 border-l-4 border-blue-600 pl-4 mb-4">
            なぜ「洗い流す消臭」が再発防止につながるのか
          </h3>
          <p class="text-gray-700 leading-relaxed mb-4">
            車内の臭い・汚れは、シートや天井の繊維・ウレタン層に原因が残っていると再発しやすいです。消臭スプレーは香料で覆い隠す対処になりがちで、<strong>温度や湿度で臭いが戻る</strong>ことがあります。
          </p>
          <p class="text-gray-700 leading-relaxed">
            当店は<strong>約40℃の温水リンサー（吸引洗浄）</strong>で汚れそのものを洗い流し、必要に応じてスチームや補助脱臭を組み合わせます。エアコン臭い・加齢臭・シート汚れなど、症状に合わせた工程をご提案します。
          </p>
        </article>
      )}

      <article>
        <h3 class="text-xl font-bold text-gray-900 border-l-4 border-blue-600 pl-4 mb-4">
          {showVomitEducation ? '特殊案件（灯油・ペット・タバコ）への専門的アプローチ' : '症状別（エアコン・加齢臭・シート・タバコ）への専門的アプローチ'}
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-gray-50 p-6 rounded-lg">
            <h4 class="font-bold text-lg text-gray-900 mb-2">⛽ 灯油こぼし（他社拒否案件）</h4>
            <p class="text-sm text-gray-700">灯油は揮発性が低く、放置すると目や喉に痛みが生じます。当店は他社が断るような100cc以上の大量こぼしでも徹底洗浄が可能。<strong>車両保険が適用されるケースも多い</strong>ため、まずはご相談ください。</p>
          </div>
          <div class="bg-gray-50 p-6 rounded-lg">
            <h4 class="font-bold text-lg text-gray-900 mb-2">🐾 ペットの毛・排泄物</h4>
            <p class="text-sm text-gray-700">繊維に深く刺さったペットの毛は、掃除機では吸えません。当店は特殊ブラシと<strong>ピンセットを用いて一本一本手作業で除去</strong>する泥臭いプロの作業を惜しみません。尿などの排泄物も温水で酵素分解します。</p>
          </div>
          <div class="bg-gray-50 p-6 rounded-lg">
            <h4 class="font-bold text-lg text-gray-900 mb-2">🚬 タバコのヤニ・臭い</h4>
            <p class="text-sm text-gray-700">天井まで染みたタバコのヤニは、芳香剤では戻りやすいです。天井からフロアまで温水洗浄し、必要なときだけオゾン脱臭を足します。完全に無臭になるとはお約束できません。これまでの施工では、<strong>気にならないところまで改善するのがおおよそ7〜8割</strong>です。どこまで落ちるかは、写真を見てから先にお伝えします。</p>
          </div>
        </div>
      </article>

      {!isTruck && showAioExtensions && (
        <article>
          <h3 class="text-xl font-bold text-gray-900 border-l-4 border-blue-600 pl-4 mb-6">
            車内汚損と保険の使い分け（判断表）
          </h3>
          <p class="text-gray-600 mb-4">
            嘔吐・灯油こぼし・ペット粗相は「偶然の事故による車内汚損」として保険が適用される場合があります。当店は見積もり時に<strong>保険利用時の実質自己負担額</strong>も併記し、使う/使わないを一緒に判断します。
          </p>
          <div class="space-y-3 md:hidden">
            {insuranceRows.map((row) => (
              <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
                <p class="text-sm font-black text-gray-900">{row.situation}</p>
                <p class="mt-2 text-sm leading-snug text-gray-700"><span class="font-bold">保険：</span>{row.insurance}</p>
                <p class="mt-1 text-sm leading-snug text-gray-600"><span class="font-bold">注意：</span>{row.note}</p>
                <p class="mt-1 text-sm font-bold leading-snug text-blue-800">{row.support}</p>
              </div>
            ))}
          </div>
          <div class="hidden overflow-x-auto rounded-lg border border-gray-200 shadow-sm md:block">
            <table class="min-w-full divide-y divide-gray-200 text-sm md:text-base">
              <thead class="bg-gray-50">
                <tr>
                  <th scope="col" class="px-4 py-3 text-left font-bold text-gray-700">状況</th>
                  <th scope="col" class="px-4 py-3 text-left font-bold text-gray-700">使える保険</th>
                  <th scope="col" class="px-4 py-3 text-left font-bold text-gray-700">免責・等級</th>
                  <th scope="col" class="px-4 py-3 text-left font-bold text-blue-700 bg-blue-50">当店サポート</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200 bg-white">
                <tr>
                  <td class="px-4 py-3 font-medium text-gray-900">自分の車を自分/家族が汚した</td>
                  <td class="px-4 py-3 text-gray-700">車両保険（一般型）</td>
                  <td class="px-4 py-3 text-gray-600">免責3〜10万円・等級ダウンあり</td>
                  <td class="px-4 py-3 text-blue-800 bg-blue-50">実質自己負担額を見積もり時に併記</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 font-medium text-gray-900">他人の車を汚した（友人・同乗者）</td>
                  <td class="px-4 py-3 text-gray-700">個人賠償責任保険</td>
                  <td class="px-4 py-3 text-gray-600">免責なし・等級影響なしが多い</td>
                  <td class="px-4 py-3 text-blue-800 bg-blue-50">施工報告書・写真・見積書発行</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 font-medium text-gray-900">カーシェア・レンタカー</td>
                  <td class="px-4 py-3 text-gray-700">基本は自己負担（実費+NOC）</td>
                  <td class="px-4 py-3 text-gray-600">規約により保険適用外が一般的</td>
                  <td class="px-4 py-3 text-blue-800 bg-blue-50">領収書を発行。到着は空き次第</td>
                </tr>
              </tbody>
            </table>
          </div>
        </article>
      )}

      {showInlineFaq && (
      <article class="bg-gray-50 rounded-2xl p-8">
        <h3 class="text-2xl font-bold text-gray-900 mb-8 text-center">よくあるご質問（専門家が回答）</h3>
        <dl class="space-y-6">
          {aioFaqs.map((item) => (
            <div>
              <dt class="text-lg font-bold text-gray-900 flex items-center">
                <span class="text-blue-600 mr-2">Q.</span> {item.q}
              </dt>
              <dd class="mt-2 text-gray-700 flex items-start pl-7">
                <span class="text-gray-400 mr-2 font-bold">A.</span>
                <p set:html={item.a} />
              </dd>
            </div>
          ))}
        </dl>
      </article>
      )}

      {/* 5. AI引用用画像プロンプト（メタ情報としてHTMLコメント内に配置・将来拡張用） */}
      <!--
        [AIO Image Generation Prompts]
        Prompt 1 (Comparison Infographic): "A highly professional, modern infographic written in Japanese comparing 'Car Dealer Seat Replacement (700,000 JPY)' with a heavy red cross, versus 'Expert Hot Water Extraction Cleaning (from 18,000 JPY / 1 seat)' with a bright green checkmark, emphasizing speed and cost-effectiveness. The background should be clean white and blue."
        Prompt 2 (Professional Expertise): "A hyper-realistic close-up photo of a Japanese professional wearing clean uniform and gloves, carefully removing pet hair from a car seat using tweezers, alongside a high-pressure hot water extraction vacuum removing brown dirty water. Highly detailed, cinematic lighting, emphasizing trustworthiness and meticulous work."
      -->

    </div>
  </div>
</section>
