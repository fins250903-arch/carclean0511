---
import { LINE_URL, TEL, INSTAGRAM_URL } from '../../lib/site';
import { CAR_PRICING, yen } from '../../data/pricingConstants';
---

<section class="py-10 bg-blue-900 bg-gradient-to-br from-blue-900 to-blue-800 text-white" data-cta-section="main_cta">
    <div class="container mx-auto px-8 text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-4 text-white">
            一人で悩まないでください！<br />
            今日のその臭い、今日解決しましょう。
        </h2>
        <p class="text-lg md:text-xl mb-3 text-amber-200 font-black">
            1シート {yen(CAR_PRICING.seatSingleBasic)}から｜軽自動車 {yen(CAR_PRICING.lightBasic)}〜（税込）
        </p>
        <p class="text-xl mb-8 text-yellow-200 font-bold">
            今すぐ無料の抗菌コートも手に入れてください！
        </p>

        {/* 主要CVは LINE / 電話に集中 */}
        <div class="flex flex-col md:flex-row justify-center gap-6 max-w-3xl mx-auto">
            <a href={LINE_URL} target="_blank" rel="noopener noreferrer" class="flex-1 bg-green-500 hover:bg-green-600 text-white p-6 rounded-xl shadow-lg transition-transform hover:scale-105 flex flex-col items-center justify-center">
                <div class="text-2xl font-bold mb-2">LINEで見積もり</div>
                <div class="text-sm">写真を送るだけでスムーズ対応</div>
            </a>
            <a href={`tel:${TEL}`} class="flex-1 bg-red-600 hover:bg-red-700 text-white p-6 rounded-xl shadow-lg transition-transform hover:scale-105 flex flex-col items-center justify-center animate-shine ring-2 ring-white/30">
                <div class="text-2xl font-bold mb-1">今すぐ電話相談</div>
                <div class="text-3xl font-black mb-1">{TEL}</div>
                <div class="text-sm">お急ぎの方は電話</div>
            </a>
        </div>
        <p class="mt-5 text-sm text-blue-100">
            施工事例を見たい方は
            <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" class="underline font-bold text-white hover:text-yellow-200 ml-1">
              Instagramもご覧ください
            </a>
        </p>
    </div>
</section>
