---
/**
 * One phone_click or line_click per tap on a normal link.
 *
 * This capture listener is the only push for light-DOM tel: and LINE anchors,
 * including links that have no component onClick. Do not also call
 * trackPhoneClick / trackLineClick from those anchors.
 *
 * df-messenger renders its buttons in shadow DOM and fires df-button-clicked.
 * ChatWidget owns that push (event_label chat_widget). Clicks inside
 * df-messenger are ignored here so the two paths cannot double-push.
 *
 * Matchers live in src/lib/conversionClicks.mjs and are unit tested.
 */
import { LINE_URL } from '@/lib/site';
import { conversionClickSource } from '@/lib/conversionClicks.mjs';

const phoneDigits = '07084280866';
const lineMatch = LINE_URL.replace(/^https?:\/\//, '');
const listenerScript = `(function () {
${conversionClickSource}
  var phoneDigits = ${JSON.stringify(phoneDigits)};
  var lineMatch = ${JSON.stringify(lineMatch)};
  document.addEventListener('click', function (event) {
    handleConversionClick(event, phoneDigits, lineMatch, function (eventName, label) {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: eventName,
        event_category: 'conversion',
        event_label: label || 'sitewide',
      });
    });
  }, true);
})();`;
---

<script is:inline set:html={listenerScript}></script>
