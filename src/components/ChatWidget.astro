---
/**
 * Dialogflow CX Messenger (Vertex AI Conversational Agents).
 * Renders only when public, non-secret IDs are set. No API key belongs here.
 */
import { resolveChatWidget } from '@/data/chatWidget';
import { STORE_NAME } from '@/lib/site';

const { projectId, agentId, location, enabled } = resolveChatWidget(import.meta.env);
---

{
  enabled && (
    <>
      <script
        is:inline
        src="https://www.gstatic.com/dialogflow-console/fast/df-messenger/prod/v1/df-messenger.js"
      />
      <df-messenger
        location={location}
        project-id={projectId}
        agent-id={agentId}
        language-code="ja"
        storage-option="none"
        max-query-length="256"
      >
        <df-messenger-chat-bubble
          expanded
          chat-title={STORE_NAME}
          chat-subtitle="料金と汚れの相談"
          placeholder-text="車種と汚れを入力"
          bot-writing-text="確認しています"
        />
      </df-messenger>
      <style is:inline>
        df-messenger {
          z-index: 1100;
          position: fixed;
          right: 16px;
          bottom: 96px;
          --df-messenger-primary-color: #0066cc;
          --df-messenger-font-family: 'Noto Sans JP', sans-serif;
          --df-messenger-button-font-size: 16px;
          --df-messenger-button-padding: 14px 16px;
          --df-messenger-button-border-radius: 12px;
        }
        @media (max-width: 640px) {
          df-messenger {
            --df-messenger-chat-window-height: 280px;
          }
        }
      </style>
    </>
  )
}

<script>
  import {
    contactButtonCard,
    provisionalNote,
    shouldOfferContactButtons,
    textFromMessengerMessages,
  } from '@/lib/chatContactButtons';
  import { pushDataLayer } from '@/lib/analytics';
  import { LINE_OA_ID, LINE_URL, TEL } from '@/lib/site';

  let contactLock = false;
  const userLines: string[] = [];

  window.addEventListener('df-user-input-entered', (event) => {
    const input = String((event as CustomEvent).detail?.input || '').trim();
    if (!input) return;
    userLines.push(input);
    if (userLines.length > 8) userLines.shift();
  });

  window.addEventListener('df-response-received', (event) => {
    if (contactLock) return;
    const detail = (event as CustomEvent).detail as { data?: { messages?: unknown } } | undefined;
    const text = textFromMessengerMessages(detail?.data?.messages);
    if (!shouldOfferContactButtons(text)) return;
    const messenger = document.querySelector('df-messenger') as
      | (HTMLElement & { renderCustomCard?: (payload: unknown[]) => void })
      | null;
    if (!messenger || typeof messenger.renderCustomCard !== 'function') return;
    contactLock = true;
    const note = provisionalNote(text, userLines);
    messenger.renderCustomCard(contactButtonCard(TEL, LINE_URL, note, LINE_OA_ID));
    window.setTimeout(() => {
      contactLock = false;
    }, 1000);
  });

  window.addEventListener('df-button-clicked', (event) => {
    const href = String((event as CustomEvent).detail?.actionLink || '');
    if (/^tel:/i.test(href)) {
      pushDataLayer('phone_click', { event_category: 'conversion', event_label: 'chat_widget' });
    } else if (/lin\.ee|line\.me\/R\/oaMessage/i.test(href)) {
      pushDataLayer('line_click', { event_category: 'conversion', event_label: 'chat_widget' });
    }
  });
</script>
