---
import { RESERVE_FORM_URL, STORE_NAME } from '../lib/site';

const title = `洗浄のご依頼 | ${STORE_NAME}`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0;url=${RESERVE_FORM_URL}`} />
    <link rel="canonical" href={RESERVE_FORM_URL} />
    <title>{title}</title>
  </head>
  <body>
    <p>
      <a href={RESERVE_FORM_URL}>洗浄のご依頼フォームを開く</a>
    </p>
  </body>
</html>
