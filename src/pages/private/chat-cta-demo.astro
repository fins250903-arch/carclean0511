---
/**
 * Prototype sandbox for the CTA chat widget proposal (docs/cta-chatbot-plan.md).
 * Deliberately kept outside the LP tree: noindex, excluded from the sitemap,
 * and already covered by `Disallow: /private/` in robots.txt.
 */
import MainLayout from '../../layouts/MainLayout.astro';
import ChatCta from '../../components/chat/ChatCta';
import FloatingCTA from '../../components/sections/FloatingCTA';
import { CAR_PRICING, yen } from '../../data/pricingConstants';

const scenarios = [
  { label: '大阪府・乗用車', regionName: '大阪府', displayName: '大阪', niche: 'car' as const },
  { label: '宮城県・トラック', regionName: '宮城県', displayName: '宮城', niche: 'truck' as const },
];
---

<MainLayout
  title="CTAチャット プロトタイプ（社内検証用）"
  description="LP未組み込みの検証ページです。"
  noindex
>
  <main class="min-h-screen bg-gray-100 pb-floating">
    <div class="mx-auto max-w-3xl px-5 py-10">
      <p class="inline-block rounded-full bg-amber-200 px-3 py-1 text-xs font-bold text-amber-900">
        社内検証用・LP未組み込み・noindex
      </p>
      <h1 class="mt-4 text-2xl font-black text-gray-800">CTAチャットボット プロトタイプ</h1>
      <p class="mt-3 text-sm leading-relaxed text-gray-600">
        右下の「30秒で料金診断」から起動します。質問は4つで、料金は
        <code class="rounded bg-white px-1">src/data/pricingConstants.ts</code>
        から算出するため、LP・広告・FAQの表示価格と必ず一致します（座席1脚
        {yen(CAR_PRICING.seatSingleBasic)}〜／軽自動車 {yen(CAR_PRICING.lightBasic)}〜）。
        既存のフローティングCTA（LINE・電話）と同時表示し、干渉しないことも確認できます。
      </p>

      <section class="mt-8 rounded-2xl bg-white p-5 shadow-sm">
        <h2 class="text-sm font-black text-gray-800">地域・車種ごとの出し分け</h2>
        <p class="mt-2 text-xs text-gray-500">
          LPと同じ props（regionName / displayName / niche）を渡すだけで文言と価格表が切り替わります。
        </p>
        <ul class="mt-3 space-y-1 text-xs text-gray-600">
          {scenarios.map((scenario) => (
            <li>・{scenario.label}：niche=<code>{scenario.niche}</code></li>
          ))}
        </ul>
      </section>

      <section class="mt-6 rounded-2xl bg-white p-5 shadow-sm">
        <h2 class="text-sm font-black text-gray-800">dataLayer イベントログ</h2>
        <p class="mt-2 text-xs text-gray-500">
          GTM に送られる計測イベントをリアルタイム表示します（この検証ページ限定）。
        </p>
        <ol id="event-log" class="mt-3 space-y-1 font-mono text-[11px] text-gray-700">
          <li class="placeholder text-gray-400">（まだイベントはありません）</li>
        </ol>
      </section>

      <section class="mt-6 rounded-2xl border-2 border-dashed border-gray-300 p-5">
        <h2 class="text-sm font-black text-gray-800">このプロトタイプでやっていないこと</h2>
        <ul class="mt-2 space-y-1 text-xs leading-relaxed text-gray-600">
          <li>・LPへの組み込み（どのregion / keyword LPにも設置していません）</li>
          <li>・折り返し予約の実送信（エンドポイント未接続のため、送信はローカル完結のモックです）</li>
          <li>・LINE公式アカウントIDを使った本文プリフィル（現状は要約をクリップボードにコピー）</li>
        </ul>
      </section>
    </div>

    <ChatCta client:load regionName="大阪府" displayName="大阪" niche="car" teaserDelaySeconds={6} />
    <FloatingCTA client:load />
  </main>
</MainLayout>

<script is:inline>
  (function () {
    var log = document.getElementById('event-log');
    if (!log) return;
    window.dataLayer = window.dataLayer || [];
    var originalPush = window.dataLayer.push.bind(window.dataLayer);
    window.dataLayer.push = function () {
      for (var i = 0; i < arguments.length; i += 1) {
        var payload = arguments[i];
        if (payload && payload.event_category === 'chat_cta') {
          if (log.querySelector('.placeholder')) log.innerHTML = '';
          var row = document.createElement('li');
          row.textContent =
            new Date().toLocaleTimeString('ja-JP') + '  ' + payload.event + '  ' + JSON.stringify(payload);
          log.appendChild(row);
        }
      }
      return originalPush.apply(null, arguments);
    };
  })();
</script>
