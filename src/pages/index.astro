---
import MainLayout from '../layouts/MainLayout.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { CAR_PRICING, yen } from '../data/pricingConstants';
import { buildNationalJsonLd } from '../lib/nationalStructuredData';
import { LINE_URL, STORE_NAME, TEL, canonicalUrl } from '../lib/site';

const jsonLd = buildNationalJsonLd();
const telHref = `tel:${TEL.replace(/-/g, '')}`;
const troubles = ['嘔吐', '臭い', 'シミ', 'ペットの毛', '食べこぼし'] as const;
const description = `車内の嘔吐、臭い、シミ、ペットの毛、食べこぼしを、その場で洗浄・消臭します。電話 ${TEL}、LINEでも受け付けます。`;
---

<MainLayout
  title={STORE_NAME}
  description={description}
  keywords="車内清掃, 車内クリーニング, シート洗浄, 嘔吐, 消臭, ペットの毛, 食べこぼし"
  canonical={canonicalUrl('/')}
  hideChat
>
  <JsonLd slot="head" data={jsonLd} />

  <main class="min-h-screen bg-white">
    <div class="mx-auto max-w-xl px-4 py-10 md:py-16">
      <h1 class="text-2xl font-black text-gray-900">{STORE_NAME}</h1>
      <p id="national-lead" class="mt-4 text-base leading-relaxed text-gray-800">
        車のシートと床を、その場で洗う車内クリーニングです。
      </p>

      <h2 class="mt-8 text-sm font-bold text-gray-500">お困りごと</h2>
      <ul class="mt-2 flex flex-wrap gap-2">
        {troubles.map((item) => (
          <li class="rounded-full bg-blue-50 px-3 py-1 text-base font-bold text-gray-900">{item}</li>
        ))}
      </ul>

      <h2 class="mt-8 text-sm font-bold text-gray-500">対応内容</h2>
      <p class="mt-2 text-base leading-relaxed text-gray-800">
        ご指定の駐車場まで伺い、汚れたシートと床を洗って、臭いの原因を吸い上げます。
      </p>

      <p class="mt-8 text-base text-gray-800">
        料金の目安は座席1脚 {yen(CAR_PRICING.seatSingleBasic)}から、軽自動車の基本洗浄 {yen(CAR_PRICING.lightBasic)}から（税込）です。
      </p>

      <div class="mt-8 flex flex-col gap-3">
        <a
          href={telHref}
          class="flex flex-col items-center justify-center rounded-xl bg-red-600 px-4 py-4 text-white"
        >
          <span class="text-sm font-bold">電話</span>
          <span class="text-2xl font-black">{TEL}</span>
        </a>
        <a
          href={LINE_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col items-center justify-center rounded-xl bg-green-500 px-4 py-4 text-white"
        >
          <span class="text-xl font-black">LINE</span>
          <span class="text-sm font-bold">写真を送るとスムーズです</span>
        </a>
      </div>
    </div>
  </main>
</MainLayout>
