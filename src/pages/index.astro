---
/**
 * `/` redirects to the nationwide page.
 * Dev returns 301. Production Cloudflare `_redirects` also 301s to `/aio/`.
 * The built file keeps a noindex meta refresh so a missed redirect still
 * lands on `/aio/`, and includes the shared footer.
 */
import '../styles/globals.css';
import SiteFooter from '../components/SiteFooter.astro';

if (import.meta.env.DEV) {
  return Astro.redirect('/aio/', 301);
}
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Redirecting to: /aio/</title>
    <meta http-equiv="refresh" content="0;url=/aio/" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="https://carinteriorcleaning.jp/aio/" />
  </head>
  <body>
    <a href="/aio/">Redirecting from <code>/</code> to <code>/aio/</code></a>
    <SiteFooter />
  </body>
</html>
