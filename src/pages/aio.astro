---
import MainLayout from '../layouts/MainLayout.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { buildNationalJsonLd, buildNationalPageFaqs } from '../lib/nationalStructuredData';
import { STORE_NAME, canonicalUrl } from '../lib/site';
import { localCaseStudies } from '../data/localCaseStudies';
import { CAR_PRICING, travelFeeAreaLabel, yen } from '../data/pricingConstants';
import {
  buildRegionalAnswerTargetPoints,
  buildRegionalAnswerFirst,
  buildRegionalNioiAnswerFirst,
  buildVoiceEmergencyLine,
  REGIONAL_EMERGENCY_CHECKLIST,
  REGIONAL_CHECKLIST_HEADING,
  REGIONAL_SITUATION_DIAGNOSIS,
} from '../data/aioKeywordContent';

import Hero from '../components/sections/Hero.astro';
import AIOContent from '../components/sections/AIOContent.astro';
import RegionAIContent from '../components/sections/RegionAIContent.astro';
import Problem from '../components/sections/Problem.astro';
import Solution from '../components/sections/Solution.astro';
import Comparison from '../components/sections/Comparison.astro';
import Campaign from '../components/sections/Campaign.astro';
import CTA from '../components/sections/CTA.astro';
import FAQ from '../components/sections/FAQ.astro';
import Reasons from '../components/sections/Reasons.astro';
import Benefits from '../components/sections/Benefits.astro';
import Roadmap from '../components/sections/Roadmap.astro';
import Targets from '../components/sections/Targets.astro';
import AreaCoverage from '../components/sections/AreaCoverage.astro';
import Flow from '../components/sections/Flow.astro';
import Profile from '../components/sections/Profile.astro';
import Expertise from '../components/sections/Expertise.astro';
import Pricing from '../components/sections/Pricing.astro';
import OperatorInfo from '../components/sections/OperatorInfo.astro';
import Closing from '../components/sections/Closing.astro';
import EmergencyChecklist from '../components/sections/EmergencyChecklist.astro';
import AnswerTarget from '../components/sections/AnswerTarget.astro';
import NioiAnswerTarget from '../components/sections/NioiAnswerTarget.astro';
import KeywordAioExtras from '../components/sections/KeywordAioExtras.astro';
import RegionLocalTrust from '../components/sections/LpRegionLocalTrustFooter.astro';
import AdLpQuickFacts from '../components/sections/AdLpQuickFacts.astro';
import CancelPolicy from '../components/sections/CancelPolicy.astro';

import { RegionProvider } from '../lib/RegionContext';
import QuestionnaireTestimonials from '../components/sections/QuestionnaireTestimonials';
import ContactForm from '../components/sections/ContactForm';
import FloatingCTA from '../components/sections/FloatingCTA';

/** Shown in place of any prefecture or city name. */
const LABEL = '地域密着';
const path = '/aio';
const pageFaqs = buildNationalPageFaqs();
const jsonLd = buildNationalJsonLd();
const neutralSummary =
  'ご指定の駐車場へ伺い、シートと床を洗って、嘔吐・灯油・ペットの毛・食べこぼし・臭いの原因を吸い上げます。料金と作業時間は、写真を見てからご案内します。';
const caseStudies = ['osaka-nbox-vomit', 'osaka-car-tobacco']
  .map((id) => localCaseStudies.find((item) => item.id === id))
  .filter((item) => item !== undefined);
---

<MainLayout
  title={`${LABEL}の出張車内クリーニング｜${STORE_NAME}`}
  description="地域密着の出張車内クリーニングです。嘔吐、臭い、シミ、ペットの毛、食べこぼしを、ご指定の駐車場で洗浄・消臭します。電話とLINEでご相談ください。"
  keywords="車内清掃, 車内クリーニング, シート洗浄, 嘔吐, 消臭, ペットの毛, 食べこぼし"
  canonical={canonicalUrl(path)}
>
  <JsonLd slot="head" data={jsonLd} />

  <RegionProvider client:load regionName={LABEL} displayName={LABEL} niche="car" path={path}>
    <main class="min-h-screen bg-white pb-floating md:pb-20">
      <Hero
        regionName={LABEL}
        displayName={LABEL}
        niche="car"
        mainTitle={`${LABEL}の出張車内クリーニング`}
      />
      <AdLpQuickFacts
        displayName={LABEL}
        niche="car"
        intentLabel="出張車内クリーニング"
        priceLabel={`1シート ${yen(CAR_PRICING.seatSingleBasic)}から／軽自動車 ${yen(CAR_PRICING.lightBasic)}〜`}
        durationLabel="作業 1.5〜3時間"
        areaLabel={travelFeeAreaLabel(LABEL, LABEL)}
      />
      <AnswerTarget
        text={buildRegionalAnswerFirst(LABEL, LABEL)}
        points={buildRegionalAnswerTargetPoints(LABEL, LABEL)}
        voiceLine={buildVoiceEmergencyLine(LABEL)}
      />
      <EmergencyChecklist
        rows={REGIONAL_EMERGENCY_CHECKLIST}
        regionName={LABEL}
        heading={REGIONAL_CHECKLIST_HEADING}
      />
      <Problem regionName={LABEL} displayName={LABEL} niche="car" />
      <Pricing regionName={LABEL} niche="car" />
      <CancelPolicy />
      <CTA />
      <QuestionnaireTestimonials client:visible displayName={LABEL} />
      <KeywordAioExtras situationDiagnosis={REGIONAL_SITUATION_DIAGNOSIS} />
      <NioiAnswerTarget regionName={LABEL} answerText={buildRegionalNioiAnswerFirst(LABEL, LABEL)} />
      <AIOContent regionName={LABEL} niche="car" focusShutchou showAioExtensions showInlineFaq={false} />
      <RegionAIContent regionName={LABEL} displayName={LABEL} neutralSummary={neutralSummary} />
      <Solution regionName={LABEL} displayName={LABEL} niche="car" />
      <Comparison displayName={LABEL} />
      <Campaign displayName={LABEL} />
      <Reasons displayName={LABEL} regionName={LABEL} />
      <Benefits />
      <Roadmap displayName={LABEL} />
      <section class="py-20 bg-white border-t border-gray-100">
        <div class="container mx-auto px-8 max-w-6xl">
          <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-4">施工の写真</h2>
            <p class="text-xl text-gray-600 font-bold">シートの奥まで洗ったあとの状態です。</p>
          </div>
          <div class="grid md:grid-cols-2 gap-10">
            {caseStudies.map((item) => (
              <div class="bg-white rounded-[32px] shadow-2xl border border-gray-100 overflow-hidden flex flex-col">
                <img src={item.image} alt={item.title} class="h-64 w-full object-cover" />
                <div class="p-8">
                  <h3 class="text-xl font-black text-gray-900 mb-4">{item.title}</h3>
                  <p class="text-gray-600 text-sm leading-relaxed">{item.problem}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
      <Targets />
      <AreaCoverage regionName={LABEL} />
      <Flow niche="car" regionName={LABEL} />
      <Profile displayName={LABEL} />
      <Expertise />
      <FAQ faqs={pageFaqs} />
      <RegionLocalTrust regionName={LABEL} displayName={LABEL} niche="car" neutral />
      <ContactForm client:visible regionName={LABEL} areaPlaceholder="例：ご住所" />
      <OperatorInfo regionName={LABEL} displayName={LABEL} neutral />
      <Closing regionName={LABEL} displayName={LABEL} niche="car" path={path} showAreaList={false} />
      <FloatingCTA client:load />
    </main>
  </RegionProvider>
</MainLayout>
