---
import MainLayout from '../../../layouts/MainLayout.astro';
import { regions } from '../../../data/regions';
import {
  AD_KEYWORD_PAGES,
  getAdKeywordPage,
} from '../../../data/adKeywordPages';
import {
  generateAdKeywordRegionMetadata,
  generateJsonLd,
} from '../../../lib/seo';
import { getRegionalPost } from '../../../lib/getRegionalPost';
import { getRegionalBlogDisplayPosts } from '../../../lib/getRegionalBlogDisplayPosts';
import { buildRegionSeoOverrides } from '../../../lib/regionStructuredData';
import { buildAdKeywordJsonLdOptions } from '../../../lib/keywordSchemaOptions';
import { generateQuestionnaireJsonLd } from '../../../data/questionnaireTestimonials';
import JsonLd from '../../../components/seo/JsonLd.astro';

import Hero from '../../../components/sections/Hero.astro';
import AIOContent from '../../../components/sections/AIOContent.astro';
import RegionAIContent from '../../../components/sections/RegionAIContent.astro';
import Problem from '../../../components/sections/Problem.astro';
import Solution from '../../../components/sections/Solution.astro';
import Comparison from '../../../components/sections/Comparison.astro';
import Campaign from '../../../components/sections/Campaign.astro';
import CTA from '../../../components/sections/CTA.astro';
import FAQ from '../../../components/sections/FAQ.astro';
import Reasons from '../../../components/sections/Reasons.astro';
import Benefits from '../../../components/sections/Benefits.astro';
import Roadmap from '../../../components/sections/Roadmap.astro';
import RegionalAchievements from '../../../components/sections/RegionalAchievements.astro';
import Targets from '../../../components/sections/Targets.astro';
import AreaCoverage from '../../../components/sections/AreaCoverage.astro';
import Flow from '../../../components/sections/Flow.astro';
import Profile from '../../../components/sections/Profile.astro';
import Expertise from '../../../components/sections/Expertise.astro';
import Pricing from '../../../components/sections/Pricing.astro';
import OperatorInfo from '../../../components/sections/OperatorInfo.astro';
import Closing from '../../../components/sections/Closing.astro';
import ServiceMutualLink from '../../../components/sections/ServiceMutualLink.astro';
import TroubleSympathy from '../../../components/sections/TroubleSympathy.astro';
import KeywordMutualLinks from '../../../components/sections/KeywordMutualLinks.astro';
import EmergencyChecklist from '../../../components/sections/EmergencyChecklist.astro';
import AnswerTarget from '../../../components/sections/AnswerTarget.astro';
import NicheCaseStudy from '../../../components/sections/NicheCaseStudy.astro';
import { buildAioContentFaqs, getAioKeywordContent, buildVoiceEmergencyLine } from '../../../data/aioKeywordContent';
import { findFvCopy, resolveFvHero } from '../../../data/fvAdGroupCopy';
import {
  resolveAdDeepTroubles,
  resolveAdField,
  resolveAdHighlight,
} from '../../../data/adKeywordPages';
import { isNoindexKeywordSlug } from '../../../data/noindexKeywordSlugs';
import { isNoindexRegionId } from '../../../data/noindexRegions';
import KeywordAioExtras from '../../../components/sections/KeywordAioExtras.astro';
import RegionLocalTrust from '../../../components/sections/LpRegionLocalTrustFooter.astro';
import AdLpQuickFacts from '../../../components/sections/AdLpQuickFacts.astro';
import AdLpProcessGuide from '../../../components/sections/AdLpProcessGuide.astro';
import { getAdLpQuickFacts } from '../../../data/adLpQuickFacts';
import { getAdLpProcessGuide } from '../../../data/adLpProcessGuide';
import AdLpIntentGuide from '../../../components/sections/AdLpIntentGuide.astro';
import { getAdLpIntentGuide, isNonEmergencyTroubleType } from '../../../data/adLpIntentGuides';
import { carFvPriceHookMain, carFvPriceHookSub, CAR_PRICING, yen } from '../../../data/pricingConstants';

import { RegionProvider } from '../../../lib/RegionContext';
import QuestionnaireTestimonials from '../../../components/sections/QuestionnaireTestimonials';
import Testimonials from '../../../components/sections/Testimonials';
import Blog from '../../../components/sections/Blog';
import ContactForm from '../../../components/sections/ContactForm';
import FloatingCTA from '../../../components/sections/FloatingCTA';

export async function getStaticPaths() {
  const paths: {
    params: { region: string; kw: string };
    props: { regionName: string; regionId: string };
  }[] = [];
  for (const region of regions) {
    for (const page of AD_KEYWORD_PAGES) {
      if (page.targetRegionIds && !page.targetRegionIds.includes(region.id)) {
        continue;
      }
      paths.push({
        params: { region: region.id, kw: page.slug },
        props: { regionName: region.name, regionId: region.id },
      });
    }
  }
  return paths;
}

const { regionName, regionId } = Astro.props;
const kwSlug = Astro.params.kw!;
const kw = getAdKeywordPage(kwSlug);
if (!kw) {
  throw new Error(`Unknown ad keyword slug: ${kwSlug}`);
}

const path = `/regions/${regionId}/${kwSlug}`;
const regionBasePath = `/regions/${regionId}`;

const post = getRegionalPost(regionName);
const displayName = post?.displayName || regionName;
const blogCases = getRegionalBlogDisplayPosts(regionId, regionName);
const questionnaireStructuredData = generateQuestionnaireJsonLd(
  regionName,
  displayName,
  path,
);
const regionOverrides = buildRegionSeoOverrides({
  regionName,
  displayName,
  blogCases,
});

const metadata = generateAdKeywordRegionMetadata(regionName, path, kw);
const aioKw = getAioKeywordContent(kwSlug);
const answerFirst = aioKw?.answerFirst(regionName, displayName);
const customDefinition = aioKw?.customDefinition?.(regionName);
const fvCopy = findFvCopy(regionId, kwSlug);
const fvHero = fvCopy ? resolveFvHero(fvCopy, regionName, displayName) : null;
const quickFacts = getAdLpQuickFacts(kwSlug);
const intentGuide = getAdLpIntentGuide(kwSlug);
const muteEmergencyTone = isNonEmergencyTroubleType(aioKw?.troubleType);
/** Visible FAQ extras must match FAQPage schema (AIOContent includeExtended ↔ schema) */
const aioVisibleFaqs = buildAioContentFaqs(regionName, {
  includeExtended: !muteEmergencyTone,
  extraFaqs: aioKw?.extraFaqs,
});
/** Bottom FAQ: skip extended to avoid duplicating AIOContent's FAQ block */
const aioExtraFaqs = buildAioContentFaqs(regionName, {
  includeExtended: false,
  extraFaqs: aioKw?.extraFaqs,
});
const jsonLdData = generateJsonLd(
  regionName,
  path,
  regionOverrides,
  'car',
  {
    ...buildAdKeywordJsonLdOptions({
      kwSlug,
      kw,
      regionName,
      displayName,
      metadata,
    }),
    extraFaqs: aioVisibleFaqs,
  },
);
const combinedJsonLd = [...jsonLdData, ...questionnaireStructuredData];
const voiceLine = muteEmergencyTone
  ? `${displayName}エリアへ出張対応。料金・所要時間の目安を確認のうえ、お電話・LINEで空き状況をご案内します。`
  : buildVoiceEmergencyLine(displayName);
const heroHighlight = resolveAdHighlight(kw.heroHighlight, regionName);

const processGuide = getAdLpProcessGuide(kwSlug);
/** 車KW LPもCTRフック「1シート 18,000円から」を主表示。KW固有価格はサブへ（重複は避ける） */
const isBusKw = kwSlug === 'bus-senmon';
const seatHookMain = carFvPriceHookMain();
const kwSpecificPrice = quickFacts?.priceLabel;
const kwPriceIsSeatLike =
  !!kwSpecificPrice &&
  (kwSpecificPrice.includes('1シート') ||
    kwSpecificPrice.includes('座席1脚') ||
    kwSpecificPrice.includes(yen(CAR_PRICING.seatSingleBasic)));
const kwPriceHookMain = isBusKw
  ? (kwSpecificPrice ?? 'バス座席洗浄 応相談')
  : seatHookMain;
const kwPriceHookSub = isBusKw
  ? `${displayName}へ出張対応｜税込見積`
  : [
      kwSpecificPrice && !kwPriceIsSeatLike ? kwSpecificPrice : null,
      carFvPriceHookSub(displayName),
    ]
      .filter(Boolean)
      .join('｜');
const quickFactsPriceLabel = isBusKw
  ? (kwSpecificPrice ?? 'バス座席洗浄 応相談')
  : kwSpecificPrice && !kwPriceIsSeatLike
    ? `${seatHookMain}／${kwSpecificPrice}`
    : `${seatHookMain}／軽自動車 ${yen(CAR_PRICING.lightBasic)}〜`;

const adHero = fvHero
  ? {
      ...fvHero,
      fvImage: kw.fvImage,
      mainTitle: fvHero.mainTitle ?? kw.mainTitle?.(regionName, displayName),
      priceHookMain: kwPriceHookMain,
      priceHookSub: kwPriceHookSub,
      priceHookNote: '※症状・範囲により変動。作業前に見積提示／写真で概算見積可',
    }
  : {
      subtitle: kw.heroSubtitle(displayName, regionName),
      highlightLine1: heroHighlight[0],
      highlightLine2: heroHighlight[1],
      subcatch: kw.heroSubcatch(displayName),
      fvImage: kw.fvImage,
      footerText: kw.heroFooter(displayName),
      mainTitle: kw.mainTitle?.(regionName, displayName),
      priceHookMain: kwPriceHookMain,
      priceHookSub: kwPriceHookSub,
      priceHookNote: '※症状・範囲により変動。作業前に見積提示／写真で概算見積可',
    };

const adProblem = {
  header: resolveAdField(kw.problemHeader, regionName),
  subHeader: resolveAdField(kw.problemSubHeader, regionName),
  dealerQuote: resolveAdField(kw.problemDealerQuote, regionName),
  bodyHtml: kw.problemBodyHtml(regionName, displayName),
  empathyImage: kw.problemEmpathyImage,
  empathyAlt: resolveAdField(kw.problemEmpathyAlt, regionName),
};

const deepTroubles = resolveAdDeepTroubles(kw.deepTroubles, regionName);

/** slug から niche を解決 */
const pageNiche: 'car' | 'truck' | 'bus' = kwSlug === 'bus-senmon' ? 'bus' : 'car';
const noindex = isNoindexKeywordSlug(kwSlug) || isNoindexRegionId(regionId);
---

<MainLayout
  title={metadata.title}
  description={metadata.description}
  keywords={metadata.keywords}
  canonical={metadata.alternates?.canonical}
  ogImage={kw.ogImage}
  noindex={noindex}
>
  <JsonLd slot="head" data={combinedJsonLd} />

  <RegionProvider client:load regionName={regionName} displayName={displayName} niche={pageNiche} path={path}>
    <main class="min-h-screen bg-white pb-floating md:pb-20">
      <Hero regionName={regionName} displayName={displayName} niche={pageNiche} adHero={adHero} />
      {quickFacts && (
        <AdLpQuickFacts
          displayName={displayName}
          intentLabel={quickFacts.intentLabel}
          priceLabel={quickFactsPriceLabel}
          durationLabel={quickFacts.durationLabel}
          areaLabel={quickFacts.areaLabel(displayName)}
        />
      )}
      {processGuide && (
        <AdLpProcessGuide
          heading={processGuide.heading}
          intro={processGuide.intro}
          steps={processGuide.steps}
          tiers={processGuide.tiers}
          caveat={processGuide.caveat}
        />
      )}
      {answerFirst && (
        <AnswerTarget text={answerFirst} voiceLine={voiceLine} />
      )}
      {intentGuide && <AdLpIntentGuide block={intentGuide} />}
      <TroubleSympathy
        displayName={displayName}
        deepTroubles={deepTroubles}
        troubleType={aioKw?.troubleType}
      />
      {aioKw?.emergencyChecklist && (
        <EmergencyChecklist
          rows={aioKw.emergencyChecklist}
          regionName={regionName}
          heading={aioKw.checklistHeading}
        />
      )}
      <KeywordAioExtras
        smellCauseTable={aioKw?.smellCauseTable}
        keroseneSeverityMatrix={aioKw?.keroseneSeverityMatrix}
        situationDiagnosis={aioKw?.situationDiagnosis}
      />
      <AIOContent
        regionName={regionName}
        niche={pageNiche}
        focusShutchou={kwSlug === 'shutchou-senmon' || kwSlug === 'mobile-cleaning'}
        customDefinition={customDefinition}
        extraFaqs={aioKw?.extraFaqs ?? []}
        showAioExtensions={!muteEmergencyTone}
        showVomitEducation={!muteEmergencyTone && aioKw?.troubleType !== 'pet-waste'}
      />
      {aioKw?.nicheCaseStudy && (
        <NicheCaseStudy block={aioKw.nicheCaseStudy(regionName)} />
      )}
      <RegionAIContent regionName={regionName} displayName={displayName} />
      <Problem regionName={regionName} displayName={displayName} niche={pageNiche} adProblem={adProblem} />
      {/* Pricing early: Ads Landing page experience needs price visibility near intent content */}
      <Pricing regionName={regionName} niche={pageNiche} />
      <QuestionnaireTestimonials client:visible displayName={displayName} />
      <Solution regionName={regionName} displayName={displayName} niche={pageNiche} />
      <Comparison displayName={displayName} />

      <Campaign displayName={displayName} />
      <Reasons displayName={displayName} regionName={regionName} />
      <Benefits />
      <Roadmap displayName={displayName} />

      <RegionalAchievements
        regionName={regionName}
        displayName={displayName}
        niche={pageNiche}
        troubleType={aioKw?.troubleType}
      />
      <Targets />
      <AreaCoverage regionName={regionName} />
      <Flow niche={pageNiche} regionName={regionName} />
      <Profile displayName={displayName} />
      <Expertise />
      <CTA />
      <FAQ niche={pageNiche} extraFaqs={aioExtraFaqs} regionName={regionName} />
      <RegionLocalTrust regionName={regionName} displayName={displayName} niche={pageNiche} />
      <Blog client:visible regionName={regionName} displayName={displayName} />
      <ServiceMutualLink
        regionName={regionName}
        displayName={displayName}
        niche={pageNiche}
        path={path}
        regionBasePath={regionBasePath}
      />
      <KeywordMutualLinks regionId={regionId} regionName={regionName} currentSlug={kwSlug} />
      <ContactForm client:visible regionName={regionName} />
      <OperatorInfo regionName={regionName} displayName={displayName} />
      <Closing regionName={regionName} displayName={displayName} niche={pageNiche} path={path} />
      <FloatingCTA client:load />
    </main>
  </RegionProvider>
</MainLayout>
