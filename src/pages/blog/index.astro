---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import '../../styles/blog.css';
import { canonicalUrl, SITE_URL, STORE_NAME } from '../../lib/site';
import { resolvePostImage } from '../../lib/blogSeo';
import { buildBlogAnswerFirst, toExcerpt } from '../../lib/blogAnswerFirst';
import { getRegionNameById, resolvePostRegionIds } from '../../lib/blogRegion';
import {
	type BlogPost,
	buildRegionBlogGroups,
	getOtherBlogPosts,
	sortPostsByNewest,
} from '../../lib/blogListing';

const allPosts = sortPostsByNewest(await getCollection('blog'));
const regionGroups = buildRegionBlogGroups(allPosts);
const otherPosts = getOtherBlogPosts(allPosts);

const getSlug = (post: BlogPost) => post.id.replace(/\/index$/, '');
const getImageSrc = (post: BlogPost) => {
	const slug = getSlug(post);
	return resolvePostImage(post.data.coverImage, slug) ?? resolvePostImage(post.data.ogp?.og_image, slug);
};
/** Answer-First lead doubles as the card excerpt so AI crawlers read facts, not a diary opening */
const excerptCache = new Map<string, string>();
const getExcerpt = (post: BlogPost) => {
	const cached = excerptCache.get(post.id);
	if (cached) return cached;
	const answer = buildBlogAnswerFirst({
		title: post.data.title,
		areaName: post.data.areaName,
		body: post.body,
		summary: post.data.summary,
		fallbackArea: getRegionNameById(resolvePostRegionIds(post)[0] ?? ''),
	});
	const excerpt = toExcerpt(answer.text, 110);
	excerptCache.set(post.id, excerpt);
	return excerpt;
};

const listingJsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'Blog',
		'@id': `${SITE_URL}/blog/`,
		name: `${STORE_NAME} 施工実例ブログ`,
		description:
			'出張車内クリーニング・消臭洗浄の施工事例を、地域・トラブル別に公開しています。各記事に費用と作業時間の実測値を掲載しています。',
		inLanguage: 'ja-JP',
		publisher: { '@id': `${SITE_URL}/#organization` },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'ItemList',
		'@id': `${SITE_URL}/blog/#latest`,
		name: '最新の施工事例',
		numberOfItems: Math.min(allPosts.length, 20),
		itemListElement: allPosts.slice(0, 20).map((post, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			url: canonicalUrl(`/blog/${getSlug(post)}`),
			name: post.data.title,
		})),
	},
];
---

<MainLayout
	title="ブログ | 車内清掃「特急便」"
	description="車内クリーニング・消臭洗浄の施工事例やお役立ち情報をお届けするブログです。"
	canonical={canonicalUrl('/blog')}
>
	<JsonLd slot="head" data={listingJsonLd} />

	<main class="blog-content min-h-screen bg-gray-50 py-12 pb-32 md:pb-12">
		<div class="max-w-5xl mx-auto px-4 sm:px-6">
			<div class="text-center mb-12">
				<h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3">施工事例ブログ</h1>
				<p class="text-lg text-gray-600">実際のクリーニング事例をご紹介しています</p>
				<a href="https://carinteriorcleaning.jp/regions/osaka/" class="inline-block mt-4 text-blue-600 hover:text-blue-800 font-medium transition-colors">← トップページへ戻る</a>
			</div>

			<div class="space-y-16" id="blog-region-sections">
				{regionGroups.map((group) => (
					<section
						data-region-name={group.regionName}
						data-region-id={group.regionId}
						class="region-section"
					>
						<h2 class="text-2xl font-bold text-gray-900 mb-6 border-b-4 border-blue-600 pb-2 inline-block pr-8">
							📍 {group.regionName}の施工実績
						</h2>
						<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
							{group.posts.map((post) => {
								const slug = getSlug(post);
								const imageSrc = getImageSrc(post);
								return (
									<article class="bg-white rounded-2xl shadow-md hover:shadow-xl transition-shadow overflow-hidden flex flex-col">
										<a href={canonicalUrl(`/blog/${slug}/`)} class="block group flex-1 flex flex-col">
											{imageSrc ? (
												<div class="overflow-hidden h-48">
													<img
														src={imageSrc}
														alt={post.data.title ?? ''}
														class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
														loading="lazy"
													/>
												</div>
											) : (
												<div class="bg-gradient-to-br from-blue-100 to-blue-200 flex items-center justify-center h-48">
													<span class="text-4xl">🚗</span>
												</div>
											)}
											<div class="p-5 flex-1 flex flex-col">
												<p class="text-sm text-gray-500 mb-2">
													<FormattedDate date={post.data.updatedDate ?? post.data.date} />
												</p>
												<h3 class="font-bold text-gray-900 group-hover:text-blue-600 transition-colors leading-snug text-base">
													{post.data.title}
												</h3>
												<p class="mt-2 text-sm leading-relaxed text-gray-600 flex-1">
													{getExcerpt(post)}
												</p>
											</div>
										</a>
									</article>
								);
							})}
						</div>
					</section>
				))}

				{otherPosts.length > 0 && (
					<section class="other-section">
						<h2 class="text-2xl font-bold text-gray-900 mb-6 border-b-4 border-gray-400 pb-2 inline-block pr-8">
							🚙 その他の実績・お知らせ
						</h2>
						<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
							{otherPosts.map((post) => {
								const slug = getSlug(post);
								const imageSrc = getImageSrc(post);
								return (
									<article class="bg-white rounded-2xl shadow-md hover:shadow-xl transition-shadow overflow-hidden flex flex-col">
										<a href={canonicalUrl(`/blog/${slug}/`)} class="block group flex-1 flex flex-col">
											{imageSrc ? (
												<div class="overflow-hidden h-48">
													<img
														src={imageSrc}
														alt={post.data.title ?? ''}
														class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
														loading="lazy"
													/>
												</div>
											) : (
												<div class="bg-gradient-to-br from-blue-100 to-blue-200 flex items-center justify-center h-48">
													<span class="text-4xl">🚗</span>
												</div>
											)}
											<div class="p-5 flex-1 flex flex-col">
												<p class="text-sm text-gray-500 mb-2">
													<FormattedDate date={post.data.updatedDate ?? post.data.date} />
												</p>
												<h3 class="font-bold text-gray-900 group-hover:text-blue-600 transition-colors leading-snug text-base">
													{post.data.title}
												</h3>
												<p class="mt-2 text-sm leading-relaxed text-gray-600 flex-1">
													{getExcerpt(post)}
												</p>
											</div>
										</a>
									</article>
								);
							})}
						</div>
					</section>
				)}
			</div>
		</div>
	</main>

	<script>
		function prioritizeRegionSection() {
			const urlParams = new URLSearchParams(window.location.search);
			const raw = urlParams.get('region');
			if (!raw) return;

			const decoded = decodeURIComponent(raw).trim();
			const container = document.getElementById('blog-region-sections');
			if (!container) return;

			const sections = [...container.querySelectorAll('section.region-section')];
			const target =
				sections.find((s) => s.getAttribute('data-region-name') === decoded) ??
				sections.find((s) => s.getAttribute('data-region-id') === decoded.toLowerCase());

			if (target) {
				container.insertBefore(target, container.firstChild);
				requestAnimationFrame(() => {
					target.scrollIntoView({ behavior: 'smooth', block: 'start' });
					window.scrollBy(0, -50);
				});
			}
		}

		prioritizeRegionSection();
		document.addEventListener('DOMContentLoaded', prioritizeRegionSection);
	</script>
</MainLayout>
