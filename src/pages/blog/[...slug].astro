---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import '../../styles/blog.css';
import BlogAnswerFirst from '../../components/blog/BlogAnswerFirst.astro';
import BlogInternalLinks from '../../components/blog/BlogInternalLinks.astro';
import BlogRelatedPosts from '../../components/blog/BlogRelatedPosts.astro';
import BlogCaseFaq from '../../components/blog/BlogCaseFaq.astro';
import BlogConversionCta from '../../components/blog/BlogConversionCta.astro';
import { canonicalUrl, SITE_URL } from '../../lib/site';
import {
  buildArticleJsonLd,
  buildBlogBreadcrumbJsonLd,
  resolveBlogMeta,
  resolvePostImage,
  toAbsoluteUrl,
} from '../../lib/blogSeo';
import { buildBlogAnswerFirst, toExcerpt } from '../../lib/blogAnswerFirst';
import { buildBlogInternalLinks } from '../../lib/blogInternalLinks';
import { buildRelatedBlogPosts } from '../../lib/blogRelatedPosts';
import {
  buildBlogFaqs,
  buildBlogFaqJsonLd,
  buildBlogHowToJsonLd,
  buildBlogOfferJsonLd,
} from '../../lib/blogFaq';
import { getRegionNameById, resolvePostRegionIds } from '../../lib/blogRegion';
import { isNoindexRegionId } from '../../data/noindexRegions';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => {
		const slug = post.id.replace(/\/index$/, '');
		return {
			params: { slug },
			props: post,
		};
	});
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const postSlug = post.id.replace(/\/index$/, '');
const heroImage = resolvePostImage(post.data.coverImage, postSlug) ?? null;
const ogImagePath =
	resolvePostImage(post.data.ogp?.og_image, postSlug) ?? heroImage;
const ogImageAbs = ogImagePath ? toAbsoluteUrl(ogImagePath) : undefined;

const regionIds = resolvePostRegionIds(post);
const primaryRegionId = regionIds.find((id) => !isNoindexRegionId(id));
const primaryRegionName = primaryRegionId ? getRegionNameById(primaryRegionId) : undefined;

const answer = buildBlogAnswerFirst({
	title: post.data.title,
	areaName: post.data.areaName,
	body: post.body,
	summary: post.data.summary,
	fallbackArea: primaryRegionName,
});
const answerExcerpt = toExcerpt(answer.text, 150);

const { title, description, noindex, ogType } = resolveBlogMeta(post, answerExcerpt);
const pageTitle = `${title} | 車内清掃「特急便」`;
const canonical = canonicalUrl(`/blog/${postSlug}`);

const internalLinks = buildBlogInternalLinks({
	regionIds,
	trouble: answer.trouble,
	area: answer.area,
	title: post.data.title,
});
const allPosts = await getCollection('blog');
const relatedPosts = buildRelatedBlogPosts(post, allPosts, {
	trouble: answer.trouble,
	regionIds,
});
const faqs = buildBlogFaqs(answer, primaryRegionName);

const articleJsonLd = buildArticleJsonLd({
	title,
	description,
	url: canonical,
	image: ogImageAbs,
	publishedTime: post.data.date,
	modifiedTime: post.data.updatedDate ?? post.data.date,
	keywords: post.data.seo?.keywords,
	regionName: primaryRegionName,
	areaName: answer.area,
	trouble: answer.trouble,
	regionLpUrl: primaryRegionId ? canonicalUrl(`/regions/${primaryRegionId}`) : undefined,
});
const breadcrumbJsonLd = buildBlogBreadcrumbJsonLd({
	postTitle: post.data.title,
	postUrl: canonical,
});
const faqJsonLd = buildBlogFaqJsonLd(faqs, canonical);
const howToJsonLd =
	answer.kind === 'case'
		? buildBlogHowToJsonLd({
				title: post.data.title,
				description,
				url: canonical,
				method: answer.method,
				workTime: answer.workTime,
				price: answer.price,
			})
		: undefined;
const offerJsonLd = buildBlogOfferJsonLd({
	url: canonical,
	regionName: primaryRegionName,
	price: answer.price,
});
const jsonLd = [articleJsonLd, breadcrumbJsonLd, faqJsonLd, howToJsonLd, offerJsonLd].filter(
	(item): item is Record<string, unknown> => Boolean(item),
);
const publishedLabel = post.data.date.toLocaleDateString('ja-JP', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
const { Content } = await render(post);
---

<MainLayout
	title={pageTitle}
	description={description}
	keywords={post.data.seo?.keywords}
	canonical={canonical}
	ogImage={ogImagePath ?? undefined}
	noindex={noindex}
	ogType={ogType}
>
	<JsonLd slot="head" data={jsonLd} />

	<main class="blog-content min-h-screen bg-white pb-32 md:pb-12">
		<article>
			{heroImage && (
				<div class="w-full max-h-[500px] overflow-hidden">
					<img src={heroImage} alt={post.data.title} class="w-full h-full object-cover" />
				</div>
			)}

			<div class="max-w-3xl mx-auto px-4 sm:px-6 py-8">
				<div class="mb-8 pb-6 border-b border-gray-200">
					<p class="text-gray-500 mb-3">
						<FormattedDate date={post.data.date} />
						{post.data.updatedDate && (
							<span class="ml-2 text-sm italic">
								(更新: <FormattedDate date={post.data.updatedDate} />)
							</span>
						)}
					</p>
					<h1 class="text-2xl md:text-3xl font-bold text-gray-900 leading-tight">{post.data.title}</h1>
					{post.data.categories && (
						<div class="mt-4 flex flex-wrap gap-2">
							{post.data.categories.map((cat: string) => (
								<span class="text-xs bg-blue-50 text-blue-700 px-3 py-1 rounded-full font-medium">{cat}</span>
							))}
						</div>
					)}
				</div>

				<BlogAnswerFirst answer={answer} publishedLabel={publishedLabel} />
				<BlogConversionCta answer={answer} compact />

				<div class="prose max-w-none">
					<Content />
				</div>

				<BlogInternalLinks links={internalLinks} />
				<BlogRelatedPosts posts={relatedPosts} />
				<BlogCaseFaq faqs={faqs} />
				<BlogConversionCta answer={answer} />

				<div class="mt-12 pt-6 border-t border-gray-200 flex flex-col sm:flex-row justify-center gap-6">
					<a href={canonicalUrl('/blog/')} class="text-blue-600 hover:text-blue-800 font-bold transition-colors flex items-center justify-center bg-gray-50 px-6 py-3 rounded-full hover:bg-gray-100">
						← ブログ一覧へ戻る
					</a>
					<a href={SITE_URL} class="text-blue-600 hover:text-blue-800 font-bold transition-colors flex items-center justify-center bg-gray-50 px-6 py-3 rounded-full hover:bg-gray-100">
						🏠 特急便トップページへ
					</a>
				</div>
			</div>
		</article>
	</main>
</MainLayout>
